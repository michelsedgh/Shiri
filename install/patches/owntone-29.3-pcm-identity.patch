index 00000000..984bc5a5
--- /dev/null
+++ b/src/outputs/pcm_identity.h
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Verify the actual opened ALSA PCM, not a pre-open name/udev serial guess.
+ * Opt-in immutable root manifest; no volume or playback scheduling changes. */
+#ifndef SHIRI_PCM_IDENTITY_H
+#define SHIRI_PCM_IDENTITY_H
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <json-c/json.h>
+#ifdef __linux__
+#include <sys/vfs.h>
+#include <linux/magic.h>
+#endif
+
+#if defined(__linux__) || defined(SHIRI_PCM_IDENTITY_TEST)
+struct pcm_identity {
+  int card, device, subdevice;
+  uint64_t sysfs_dev, sysfs_ino, node_dev, node_ino, node_rdev;
+  const char *boot, *sysfs, *node;
+};
+static bool pcm_identity_number(struct json_object *object, const char *name, uint64_t *value, bool positive) {
+  struct json_object *member;
+  int64_t number;
+  if (!json_object_object_get_ex(object,name,&member) || !json_object_is_type(member,json_type_int)) return false;
+  number=json_object_get_int64(member);
+  if (number < (positive ? 1 : 0) || json_object_get_uint64(member) > INT64_MAX) return false;
+  *value=(uint64_t)number; return true;
+}
+static const char *pcm_identity_string(struct json_object *object,const char *name) {
+  struct json_object *member;
+  const char *value;
+  if (!json_object_object_get_ex(object,name,&member) || !json_object_is_type(member,json_type_string)) return NULL;
+  value=json_object_get_string(member);
+  return value && strlen(value)==(size_t)json_object_get_string_len(member) ? value : NULL;
+}
+static bool pcm_identity_boot_valid(const char *value) {
+  size_t i;
+  if (!value || strlen(value)!=36) return false;
+  for (i=0;i<36;i++) {
+    if (i==8 || i==13 || i==18 || i==23) { if(value[i]!='-') return false; }
+    else if (!((value[i]>='0' && value[i]<='9') || (value[i]>='a' && value[i]<='f'))) return false;
+  }
+  return true;
+}
+/* json-c intentionally accepts duplicate keys. Count top-level separators in
+ * this flat, scalar-only schema too, so duplicate field corruption fails. */
+static bool pcm_identity_fields(const char *data,size_t size) {
+  size_t i,fields=0; int depth=0; bool quoted=false,escaped=false;
+  for(i=0;i<size;i++) {
+    if (quoted) {
+      if (escaped) escaped=false;
+      else if(data[i]=='\\') escaped=true;
+      else if(data[i]=='"') quoted=false;
+    } else if(data[i]=='"') quoted=true;
+    else if(data[i]=='{' || data[i]=='[') { if(++depth>1) return false; }
+    else if(data[i]=='}' || data[i]==']') depth--;
+    else if(data[i]==':' && depth==1) fields++;
+  }
+  return fields==12 && depth==0 && !quoted;
+}
+static struct json_object *pcm_identity_load(const char *path,struct pcm_identity *identity) {
+  struct stat before,after;
+  struct json_tokener *parser=NULL;
+  struct json_object *object=NULL;
+  uint64_t version,card,device,subdevice;
+  char buffer[4097],extra,expected_node[128],suffix[64];
+  ssize_t size=0,count;
+  int fd=-1;
+  size_t end;
+  fd=open(path,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);
+  if(fd<0 || fstat(fd,&before) || !S_ISREG(before.st_mode) || before.st_uid!=0 || before.st_nlink!=1 ||
+     (before.st_mode&022) || before.st_size<1 || before.st_size>4096) goto fail;
+  while(size<before.st_size) {
+    count=read(fd,buffer+size,(size_t)(before.st_size-size));
+    if(count<0 && errno==EINTR) continue;
+    if(count<=0) goto fail;
+    size+=count;
+  }
+  if(read(fd,&extra,1)!=0 || fstat(fd,&after) || before.st_dev!=after.st_dev || before.st_ino!=after.st_ino ||
+     before.st_size!=after.st_size || before.st_mode!=after.st_mode || before.st_uid!=after.st_uid || after.st_nlink!=1) goto fail;
+  close(fd);fd=-1;buffer[size]=0;
+  if(!pcm_identity_fields(buffer,(size_t)size)) goto fail;
+  parser=json_tokener_new_ex(4);
+  if(!parser) goto fail;
+  json_tokener_set_flags(parser,JSON_TOKENER_STRICT);
+  object=json_tokener_parse_ex(parser,buffer,(int)size);
+  end=json_tokener_get_parse_end(parser);
+  while(end<(size_t)size && (buffer[end]==' ' || buffer[end]=='\n' || buffer[end]=='\r' || buffer[end]=='\t')) end++;
+  if(json_tokener_get_error(parser)!=json_tokener_success || end!=(size_t)size ||
+     !object || !json_object_is_type(object,json_type_object) || json_object_object_length(object)!=12 ||
+     !pcm_identity_number(object,"version",&version,true) || version!=1 ||
+     !pcm_identity_number(object,"card_index",&card,false) || card>INT_MAX ||
+     !pcm_identity_number(object,"device",&device,false) || device>INT_MAX ||
+     !pcm_identity_number(object,"subdevice",&subdevice,false) || subdevice>INT_MAX ||
+     !pcm_identity_number(object,"sysfs_st_dev",&identity->sysfs_dev,true) ||
+     !pcm_identity_number(object,"sysfs_st_ino",&identity->sysfs_ino,true) ||
+     !pcm_identity_number(object,"node_st_dev",&identity->node_dev,true) ||
+     !pcm_identity_number(object,"node_st_ino",&identity->node_ino,true) ||
+     !pcm_identity_number(object,"node_st_rdev",&identity->node_rdev,true)) goto fail;
+  identity->card=(int)card;identity->device=(int)device;identity->subdevice=(int)subdevice;
+  identity->boot=pcm_identity_string(object,"boot_id");
+  identity->sysfs=pcm_identity_string(object,"sysfs_path");
+  identity->node=pcm_identity_string(object,"node_path");
+  snprintf(expected_node,sizeof(expected_node),"/dev/snd/pcmC%dD%dp",identity->card,identity->device);
+  snprintf(suffix,sizeof(suffix),"/card%d",identity->card);
+  if(!pcm_identity_boot_valid(identity->boot) || !identity->sysfs || strlen(identity->sysfs)>=PATH_MAX ||
+     strncmp(identity->sysfs,"/sys/devices/",13) || strlen(identity->sysfs)<strlen(suffix) ||
+     strcmp(identity->sysfs+strlen(identity->sysfs)-strlen(suffix),suffix) ||
+     !identity->node || strcmp(identity->node,expected_node)) goto fail;
+  json_tokener_free(parser);return object;
+ fail:
+  if(fd>=0) close(fd);
+  if(parser) json_tokener_free(parser);
+  if(object) json_object_put(object);
+  return NULL;
+}
+static bool pcm_identity_node(const struct stat *info,const struct pcm_identity *identity) {
+  return S_ISCHR(info->st_mode) && (uint64_t)info->st_dev==identity->node_dev &&
+    (uint64_t)info->st_ino==identity->node_ino && (uint64_t)info->st_rdev==identity->node_rdev;
+}
+static bool pcm_identity_paths(const struct pcm_identity *identity) {
+  struct stat info; struct statfs filesystem;
+  int fd=open(identity->sysfs,O_PATH|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+  bool valid=false;
+  if(fd<0) return false;
+  valid=!fstatfs(fd,&filesystem) && filesystem.f_type==SYSFS_MAGIC && !fstat(fd,&info) &&
+    S_ISDIR(info.st_mode) && (uint64_t)info.st_dev==identity->sysfs_dev && (uint64_t)info.st_ino==identity->sysfs_ino;
+  close(fd);
+  if(!valid) return false;
+  fd=open(identity->node,O_PATH|O_NOFOLLOW|O_CLOEXEC);
+  if(fd<0) return false;
+  valid=!fstat(fd,&info) && pcm_identity_node(&info,identity);
+  close(fd);return valid;
+}
+static bool pcm_identity_boot(const char *expected) {
+  char value[38]; ssize_t size;
+  int fd=open("/proc/sys/kernel/random/boot_id",O_RDONLY|O_NOFOLLOW|O_CLOEXEC);
+  if(fd<0) return false;
+  size=read(fd,value,sizeof(value));close(fd);
+  return size==37 && value[36]=='\n' && !memcmp(value,expected,36);
+}
+/* The root broker retains its sysfs pin for the full daemon lifetime. Opened
+ * plughw slaves must still expose this exact hardware through ALSA info/poll. */
+static int pcm_identity_validate(snd_pcm_t *pcm,const char *manifest) {
+  struct pcm_identity identity;
+  struct json_object *object=NULL;
+  snd_pcm_info_t *info=NULL;
+  struct pollfd *descriptors=NULL;
+  struct stat node;
+  int count,i,result=-1;
+  bool found=false;
+  if(!manifest) return 0;
+  object=pcm_identity_load(manifest,&identity);
+  if(!object || !pcm_identity_boot(identity.boot) || !pcm_identity_paths(&identity)) goto done;
+  if(snd_pcm_info_malloc(&info)<0 || !info || snd_pcm_info(pcm,info)<0 ||
+     snd_pcm_info_get_stream(info)!=SND_PCM_STREAM_PLAYBACK || snd_pcm_info_get_card(info)!=identity.card ||
+     snd_pcm_info_get_device(info)!=(unsigned int)identity.device || snd_pcm_info_get_subdevice(info)!=(unsigned int)identity.subdevice) goto done;
+  count=snd_pcm_poll_descriptors_count(pcm);
+  /* Supported direct hw/plughw endpoints need one PCM FD. Reject unbounded or
+   * opaque custom plugins instead of guessing their hardware provenance. */
+  if(count<1 || count>64) goto done;
+  descriptors=calloc((size_t)count,sizeof(*descriptors));
+  if(!descriptors || snd_pcm_poll_descriptors(pcm,descriptors,(unsigned int)count)!=count) goto done;
+  for(i=0;i<count;i++) {
+    if(descriptors[i].fd<0 || fstat(descriptors[i].fd,&node)) goto done;
+    if(S_ISCHR(node.st_mode)) {
+      if(!pcm_identity_node(&node,&identity)) goto done;
+      found=true;
+    }
+  }
+  if(!found || !pcm_identity_boot(identity.boot) || !pcm_identity_paths(&identity)) goto done;
+  result=0;
+ done:
+  free(descriptors);
+  if(info) snd_pcm_info_free(info);
+  if(object) json_object_put(object);
+  return result;
+}
+#else
+/* The guarded profile is Linux-only; never weaken it on another platform. */
+static int pcm_identity_validate(snd_pcm_t *pcm,const char *manifest) {
+  (void)pcm;return manifest ? -1 : 0;
+}
+#endif
+#endif
