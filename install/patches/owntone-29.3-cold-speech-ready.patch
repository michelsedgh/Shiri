+static uint64_t
+shiri_speech_ready_now(void)
+{
+  struct timespec ts;
+  if (clock_gettime(CLOCK_MONOTONIC, &ts) < 0 || ts.tv_sec < 0 || ts.tv_nsec < 0 || ts.tv_nsec >= 1000000000L ||
+      (uint64_t)ts.tv_sec > ((uint64_t)INT64_MAX - (uint64_t)ts.tv_nsec) / UINT64_C(1000000000))
+    return 0;
+  return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec;
+}
+
+static bool
+shiri_speech_source_matches(const struct shiri_speech_request *request)
+{
+  return request && shiri_speech_ids_match(request->room, request->launch)
+    && !shiri_zero(request->speech, 16)
+    && shiri_source_state.initialized && !shiri_source_state.faulted
+    && request->source.operation_generation == shiri_source_state.last.operation_generation
+    && shiri_source_owner_equal(&request->source.owner, &shiri_source_state.last.owner);
+}
+
+static bool
+shiri_speech_request_matches(const struct shiri_speech_request *request)
+{
+  return shiri_speech_start.initialized && request &&
+    !memcmp(request->speech, shiri_speech_start.request.speech, 16) &&
+    !memcmp(request->room, shiri_speech_start.request.room, 16) &&
+    !memcmp(request->launch, shiri_speech_start.request.launch, 16) &&
+    request->source.operation_generation == shiri_speech_start.request.source.operation_generation &&
+    shiri_source_owner_equal(&request->source.owner, &shiri_speech_start.request.source.owner);
+}
+
+static int
+shiri_speech_outputs_snapshot(bool capture, bool sessions)
+{
+  struct output_device *device;
+  unsigned count = 0, visited = 0, index;
+  for (device = outputs_list(); device; device = device->next) {
+    if (++visited > 1024) return -1;
+    if (!device->selected) continue;
+    if (count == SHIRI_SPEECH_OUTPUTS || device->busy || device->prevent_playback) return -1;
+    if (capture) {
+      shiri_speech_start.outputs[count].id = device->id;
+      shiri_speech_start.outputs[count].type = device->type;
+      shiri_speech_start.outputs[count].offset_ms = device->offset_ms;
+      shiri_speech_start.outputs[count].session = device->session;
+    } else {
+      for (index = 0; index < shiri_speech_start.count; ++index)
+        if (shiri_speech_start.outputs[index].id == device->id) break;
+      if (index == shiri_speech_start.count || shiri_speech_start.outputs[index].type != (int)device->type ||
+          shiri_speech_start.outputs[index].offset_ms != device->offset_ms) return -1;
+      if (sessions) {
+        if (!device->session || (device->state != OUTPUT_STATE_CONNECTED && device->state != OUTPUT_STATE_STREAMING)) return -1;
+        if (shiri_speech_start.outputs[index].session != device->session) return -1;
+      }
+    }
+    ++count;
+  }
+  if (!count || (!capture && count != shiri_speech_start.count)) return -1;
+  if (capture) shiri_speech_start.count = count;
+  return 0;
+}
+
+static void
+shiri_speech_reap_start_callbacks(void)
+{
+  unsigned index;
+  for (index = 0; index < shiri_speech_start.count; ++index)
+    if (shiri_speech_start.outputs[index].awaiting &&
+        !outputs_shiri_callback_pending(shiri_speech_start.outputs[index].id, device_shiri_speech_start_cb)) {
+      shiri_speech_start.outputs[index].awaiting = false;
+      if (shiri_speech_start.pending) --shiri_speech_start.pending;
+      shiri_speech_start.failed = true;
+    }
+}
+
+static void
+shiri_speech_schedule_idle_stop(void)
+{
+  struct output_device *device;
+  unsigned index, visited = 0;
+  if (!shiri_speech_source_matches(&shiri_speech_start.request)) return;
+  for (device = outputs_list(); device && ++visited <= 1024; device = device->next)
+    for (index = 0; index < shiri_speech_start.count; ++index)
+      if (device->id == shiri_speech_start.outputs[index].id &&
+          (int)device->type == shiri_speech_start.outputs[index].type &&
+          device->offset_ms == shiri_speech_start.outputs[index].offset_ms &&
+          device->session && device->session == shiri_speech_start.outputs[index].session)
+        outputs_device_stop_delayed(device, device_streaming_cb);
+  /* Replacing the START registry token retires its callback ownership. */
+  shiri_speech_reap_start_callbacks();
+}
+
+
+static bool
+shiri_speech_bind_session(struct output_device *device)
+{
+  unsigned index;
+  if (!device || !device->selected || !shiri_speech_source_matches(&shiri_speech_start.request)) return false;
+  for (index = 0; index < shiri_speech_start.count; ++index)
+    if (device->id == shiri_speech_start.outputs[index].id) {
+      if (shiri_speech_start.outputs[index].type != (int)device->type ||
+          shiri_speech_start.outputs[index].offset_ms != device->offset_ms ||
+          (shiri_speech_start.outputs[index].session && shiri_speech_start.outputs[index].session != device->session))
+        return false;
+      shiri_speech_start.outputs[index].session = device->session;
+      return device->session != NULL;
+    }
+  return false;
+}
+
+static void
+shiri_speech_setup_event_clear(void)
+{
+  if (shiri_speech_setup_event) {
+    event_free(shiri_speech_setup_event);
+    shiri_speech_setup_event = NULL;
+  }
+}
+
+static void
+shiri_speech_setup_timeout(int fd, short what, void *arg)
+{
+  (void)fd; (void)what; (void)arg;
+  shiri_speech_setup_event_clear();
+  /* This only expires an exact idle setup; it never ends a player command,
+   * flushes a source or stops a successor's transport session. */
+  if (!shiri_speech_start.initialized || shiri_speech_start.connected) return;
+  shiri_speech_start.failed = true;
+  shiri_speech_schedule_idle_stop();
+}
+
+static void
+device_shiri_speech_start_cb(struct output_device *device, enum output_device_state status)
+{
+  uint64_t now = shiri_speech_ready_now();
+  unsigned index;
+  if (!shiri_speech_start.initialized || !shiri_speech_start.pending) return;
+  if (!device) {
+    shiri_speech_start.failed = true;
+    --shiri_speech_start.pending;
+    return;
+  }
+  for (index = 0; index < shiri_speech_start.count; ++index)
+    if (shiri_speech_start.outputs[index].id == device->id && shiri_speech_start.outputs[index].awaiting) break;
+  if (index == shiri_speech_start.count) return;
+  shiri_speech_start.outputs[index].awaiting = false;
+  --shiri_speech_start.pending;
+  if (!shiri_speech_bind_session(device) || (status != OUTPUT_STATE_CONNECTED && status != OUTPUT_STATE_STREAMING) ||
+      !now || now < shiri_speech_start.began_ns || now - shiri_speech_start.began_ns >= SHIRI_SPEECH_SETUP_NS)
+    shiri_speech_start.failed = true;
+  else
+    outputs_device_cb_set(device, device_streaming_cb);
+  /* No commands_exec_end: a missing network callback must never retain
+   * cmdbase or complete a different command that has subsequently started. */
+}
+
+static enum command_state
+shiri_speech_prepare(void *arg, int *retval)
+{
+  struct shiri_speech_param *param = arg;
+  uint64_t now = shiri_speech_ready_now();
+  struct output_device *device;
+  struct timeval deadline = { 5, 0 };
+  unsigned visited = 0, index;
+  int ret;
+  if (!now || !shiri_zero(param->request.source.owner.session, 16) || !shiri_speech_source_matches(&param->request) ||
+      (player_state == PLAY_PLAYING && !pb_timer_native)) {
+    *retval = SHIRI_SOURCE_CONFLICT; return COMMAND_END;
+  }
+  shiri_speech_reap_start_callbacks();
+  if (shiri_speech_request_matches(&param->request)) {
+    *retval = shiri_speech_start.failed ? SHIRI_SOURCE_FAILURE : 0;
+    return COMMAND_END;
+  }
+  /* Retain the old callback incarnation until every START has terminated.
+   * Never reinterpret a late callback as the successor speech preparation. */
+  if (shiri_speech_start.pending) {
+    *retval = SHIRI_SOURCE_CONFLICT; return COMMAND_END;
+  }
+  shiri_speech_setup_event_clear();
+  memset(&shiri_speech_start, 0, sizeof(shiri_speech_start));
+  shiri_speech_start.request = param->request;
+  shiri_speech_start.initialized = true;
+  shiri_speech_start.began_ns = now;
+  if (shiri_speech_outputs_snapshot(true, false) < 0) {
+    shiri_speech_start.failed = true; *retval = SHIRI_SOURCE_FAILURE; return COMMAND_END;
+  }
+  shiri_speech_setup_event = evtimer_new(evbase_player, shiri_speech_setup_timeout, NULL);
+  if (!shiri_speech_setup_event || evtimer_add(shiri_speech_setup_event, &deadline) < 0) {
+    shiri_speech_setup_event_clear(); shiri_speech_start.failed = true;
+    *retval = SHIRI_SOURCE_FAILURE; return COMMAND_END;
+  }
+  for (device = outputs_list(); device && ++visited <= 1024; device = device->next) {
+    if (!device->selected) continue;
+    for (index = 0; index < shiri_speech_start.count; ++index)
+      if (shiri_speech_start.outputs[index].id == device->id) break;
+    if (index == shiri_speech_start.count || outputs_shiri_stop_delayed_cancel(device) < 0) {
+      shiri_speech_start.failed = true; break;
+    }
+    /* Publish exact callback ownership even if a backend completes inline. */
+    shiri_speech_start.outputs[index].awaiting = true;
+    ++shiri_speech_start.pending;
+    ret = outputs_device_start(device, device_shiri_speech_start_cb, false);
+    if (ret <= 0 && shiri_speech_start.outputs[index].awaiting) {
+      shiri_speech_start.outputs[index].awaiting = false; --shiri_speech_start.pending;
+    }
+    if (ret < 0 || !shiri_speech_bind_session(device)) shiri_speech_start.failed = true;
+  }
+  if (visited > 1024) shiri_speech_start.failed = true;
+  *retval = shiri_speech_start.failed ? SHIRI_SOURCE_FAILURE : 0;
+  return COMMAND_END; /* Always release the ordinary player command lane. */
+}
+
+static enum command_state
+shiri_speech_prepare_bh(void *arg, int *retval)
+{
+  struct shiri_speech_param *param = arg;
+  uint64_t now = shiri_speech_ready_now();
+  if (!shiri_speech_request_matches(&param->request) || !shiri_speech_source_matches(&param->request)) {
+    *retval = SHIRI_SOURCE_CONFLICT; return COMMAND_END;
+  }
+  if (!now || now < shiri_speech_start.began_ns || now - shiri_speech_start.began_ns >= SHIRI_SPEECH_SETUP_NS ||
+      shiri_speech_start.failed) {
+    shiri_speech_start.failed = true; shiri_speech_setup_event_clear(); shiri_speech_schedule_idle_stop();
+    *retval = SHIRI_SOURCE_FAILURE; return COMMAND_END;
+  }
+  shiri_speech_reap_start_callbacks();
+  if (shiri_speech_start.failed) { *retval = SHIRI_SOURCE_FAILURE; return COMMAND_END; }
+  param->reply.outputs = shiri_speech_start.count;
+  if (shiri_speech_start.pending) { *retval = 0; return COMMAND_END; }
+  if (shiri_speech_outputs_snapshot(false, true) < 0) {
+    shiri_speech_start.failed = true; shiri_speech_setup_event_clear(); shiri_speech_schedule_idle_stop();
+    *retval = SHIRI_SOURCE_FAILURE; return COMMAND_END;
+  }
+  shiri_speech_setup_event_clear();
+  if (!shiri_speech_start.connected) shiri_speech_start.prepared_ns = now;
+  shiri_speech_start.connected = true;
+  /* A lost caller cannot reserve idle transports permanently. Starting the
+   * actual bed cancels this existing finite delayed-stop mechanism. */
+  if (player_state != PLAY_PLAYING) shiri_speech_schedule_idle_stop();
+  param->reply.connected = true;
+  param->reply.prepared_ns = shiri_speech_start.prepared_ns;
+  *retval = 0; return COMMAND_END;
+}
+
+static int
+shiri_speech_last_outputs(bool capture)
+{
+  struct output_device *device;
+  unsigned count = 0, visited = 0, index;
+  for (device = outputs_list(); device; device = device->next) {
+    if (++visited > 1024) return -1;
+    if (!device->selected) continue;
+    if (count == SHIRI_SPEECH_OUTPUTS || device->busy || device->prevent_playback || !device->session ||
+        (device->state != OUTPUT_STATE_CONNECTED && device->state != OUTPUT_STATE_STREAMING)) return -1;
+    if (capture) {
+      shiri_last_mix.outputs[count].id = device->id;
+      shiri_last_mix.outputs[count].type = device->type;
+      shiri_last_mix.outputs[count].offset_ms = device->offset_ms;
+      shiri_last_mix.outputs[count].session = device->session;
+    } else {
+      for (index = 0; index < shiri_last_mix.count; ++index)
+        if (shiri_last_mix.outputs[index].id == device->id) break;
+      if (index == shiri_last_mix.count || shiri_last_mix.outputs[index].type != (int)device->type ||
+          shiri_last_mix.outputs[index].offset_ms != device->offset_ms ||
+          shiri_last_mix.outputs[index].session != device->session) return -1;
+    }
+    ++count;
+  }
+  if (!count || (!capture && count != shiri_last_mix.count)) return -1;
+  if (capture) shiri_last_mix.count = count;
+  return 0;
+}
+
+static void
+shiri_speech_mix_ready(void)
+{
+  uint64_t now;
+  if (!pb_timer_native || !pb_timer_native_anchored || player_state != PLAY_PLAYING ||
+      pb_session.quality.sample_rate != 48000 || pb_session.quality.bits_per_sample != 16 ||
+      pb_session.quality.channels != 2 || !shiri_source_state.initialized || shiri_source_state.faulted ||
+      !(now = shiri_speech_ready_now()) || shiri_speech_last_outputs(true) < 0) return;
+  shiri_last_mix.source = shiri_source_state.last;
+  shiri_last_mix.mixed_ns = now;
+  if (shiri_speech_start.connected && !shiri_speech_start.failed &&
+      shiri_speech_source_matches(&shiri_speech_start.request) && shiri_speech_outputs_snapshot(false, true) == 0)
+    shiri_speech_start.mixed_ns = now;
+}
+
+static enum command_state
+shiri_speech_ready_check(void *arg, int *retval)
+{
+  struct shiri_speech_param *param = arg;
+  uint64_t now = shiri_speech_ready_now();
+  if (param->request.action == SHIRI_SPEECH_OBSERVE) {
+    if (shiri_zero(param->request.source.owner.session, 16) || !shiri_speech_source_matches(&param->request)) {
+      *retval = SHIRI_SOURCE_CONFLICT; return COMMAND_END;
+    }
+    /* Pure observation: no output setup or program control on music. */
+    param->reply.connected = shiri_speech_last_outputs(false) == 0;
+    param->reply.outputs = param->reply.connected ? shiri_last_mix.count : 0;
+    param->reply.mixed_ns = shiri_last_mix.mixed_ns;
+    param->reply.ready = now && param->reply.connected && pb_timer_native && pb_timer_native_anchored &&
+      player_state == PLAY_PLAYING && shiri_last_mix.source.operation_generation == param->request.source.operation_generation &&
+      shiri_source_owner_equal(&shiri_last_mix.source.owner, &param->request.source.owner) &&
+      shiri_last_mix.mixed_ns && shiri_last_mix.mixed_ns <= now && now-shiri_last_mix.mixed_ns < SHIRI_SPEECH_MIX_AGE_NS;
+    *retval = 0; return COMMAND_END;
+  }
+  if (!shiri_speech_request_matches(&param->request) || !shiri_speech_source_matches(&param->request)) {
+    *retval = SHIRI_SOURCE_CONFLICT; return COMMAND_END;
+  }
+  if (param->request.action == SHIRI_SPEECH_RELEASE) {
+    shiri_speech_schedule_idle_stop();
+    shiri_speech_setup_event_clear();
+    if (shiri_speech_start.pending) shiri_speech_start.failed = true;
+    else memset(&shiri_speech_start, 0, sizeof(shiri_speech_start));
+    *retval = 0; return COMMAND_END;
+  }
+  if (!now || shiri_speech_start.failed || !shiri_speech_start.connected ||
+      now < shiri_speech_start.began_ns || now - shiri_speech_start.began_ns >= SHIRI_SPEECH_SETUP_NS ||
+      shiri_speech_outputs_snapshot(false, true) < 0) {
+    *retval = SHIRI_SOURCE_FAILURE; return COMMAND_END;
+  }
+  param->reply.connected = true;
+  param->reply.prepared_ns = shiri_speech_start.prepared_ns;
+  param->reply.mixed_ns = shiri_speech_start.mixed_ns;
