new file mode 100644
--- /dev/null
+++ b/src/shiri_speech_ready.h
@@ -0,0 +1,20 @@
+/* Private proposal: idle-only readiness; the existing player owns all clocks. */
+#ifndef SHIRI_SPEECH_READY_H
+#define SHIRI_SPEECH_READY_H
+#include "shiri_source.h"
+#define SHIRI_SPEECH_OUTPUTS 128
+#define SHIRI_SPEECH_SETUP_NS UINT64_C(5000000000)
+#define SHIRI_SPEECH_MIX_AGE_NS UINT64_C(100000000)
+enum shiri_speech_action { SHIRI_SPEECH_PREPARE, SHIRI_SPEECH_READY, SHIRI_SPEECH_RELEASE, SHIRI_SPEECH_OBSERVE };
+struct shiri_speech_request {
+  struct shiri_source_request source;
+  uint8_t room[16], launch[16], speech[16];
+  enum shiri_speech_action action;
+};
+struct shiri_speech_reply {
+  bool connected, ready;
+  uint64_t prepared_ns, mixed_ns;
+  unsigned outputs;
+};
+int player_shiri_speech_ready(const struct shiri_speech_request *request, struct shiri_speech_reply *reply);
+#endif
diff --git a/src/shiri_speech_ready_json.h b/src/shiri_speech_ready_json.h
new file mode 100644
--- /dev/null
+++ b/src/shiri_speech_ready_json.h
@@ -0,0 +1,39 @@
+#ifndef SHIRI_SPEECH_READY_JSON_H
+#define SHIRI_SPEECH_READY_JSON_H
+#include "shiri_speech_ready.h"
+#include "shiri_source_json.h"
+#include "outputs/cast_json.h"
+static inline int
+shiri_speech_ready_parse(json_object *body, struct shiri_speech_request *request)
+{
+  static const char *keys[] = { "incarnation", "session_id", "epoch", "generation", "operation_generation" };
+  json_object *source, *value, *room, *launch, *speech, *action;
+  const char *text;
+  unsigned index;
+  int ret;
+  if (!body || !json_object_is_type(body, json_type_object) || json_object_object_length(body) != 9 ||
+      !json_object_object_get_ex(body, "room_id", &room) || !json_object_object_get_ex(body, "launch_generation", &launch) ||
+      !json_object_object_get_ex(body, "speech_id", &speech) || !json_object_object_get_ex(body, "action", &action)) return -1;
+  memset(request, 0, sizeof(*request));
+  if (shiri_source_hex(room, request->room) < 0 || shiri_zero(request->room, 16) ||
+      shiri_source_hex(launch, request->launch) < 0 || shiri_zero(request->launch, 16) ||
+      shiri_source_hex(speech, request->speech) < 0 || shiri_zero(request->speech, 16) ||
+      !json_object_is_type(action, json_type_string)) return -1;
+  text = json_object_get_string(action);
+  if ((size_t)json_object_get_string_len(action) != strlen(text)) return -1;
+  if (!strcmp(text, "prepare")) request->action = SHIRI_SPEECH_PREPARE;
+  else if (!strcmp(text, "ready")) request->action = SHIRI_SPEECH_READY;
+  else if (!strcmp(text, "release")) request->action = SHIRI_SPEECH_RELEASE;
+  else if (!strcmp(text, "observe")) request->action = SHIRI_SPEECH_OBSERVE;
+  else return -1;
+  source = json_object_new_object();
+  if (!source) return -1;
+  for (index = 0; index < 5; ++index) {
+    if (!json_object_object_get_ex(body, keys[index], &value)) { json_object_put(source); return -1; }
+    json_object_object_add(source, keys[index], json_object_get(value));
+  }
+  ret = shiri_source_parse(source, &request->source);
+  json_object_put(source);
+  return ret < 0 || (shiri_zero(request->source.owner.session, 16) == (request->action == SHIRI_SPEECH_OBSERVE)) ? -1 : 0;
+}
+#endif
