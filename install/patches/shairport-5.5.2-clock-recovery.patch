+/* A refused clock candidate never owns media or changes its source calendar.
+ * Retry only ETIMEDOUT under one callback deadline; each inner sampler retains
+ * its original four-attempt, five-millisecond and one-millisecond bounds. */
+#define SHIRI_CLOCK_RECOVERY_BATCHES 4u
+#define SHIRI_CLOCK_RECOVERY_NS UINT64_C(20000000)
+static struct {
+  uint64_t started_ns, checked_ns, elapsed_ns;
+  unsigned int batches, refused;
+  int last_batch_result, result;
+} clock_recovery;
+static uint64_t recovered_packets, refused_batches;
+
+static int clock_recovery_deadline(void) {
+  uint64_t now = monotonic_ns();
+  if (!now || now < clock_recovery.checked_ns) {
+    clock_recovery.result = EIO;
+    return EIO;
+  }
+  clock_recovery.checked_ns = now;
+  clock_recovery.elapsed_ns = now - clock_recovery.started_ns;
+  if (clock_recovery.elapsed_ns >= SHIRI_CLOCK_RECOVERY_NS) {
+    clock_recovery.result = ETIMEDOUT;
+    return ETIMEDOUT;
+  }
+  return 0;
+}
+
+static int sample_clocks_recovered(struct shiri_pcm_packet *packet) {
+  unsigned int batch;
+  memset(&clock_recovery, 0, sizeof(clock_recovery));
+  memset(&clock_order, 0, sizeof(clock_order));
+  clock_order.active = 1;
+  clock_recovery.started_ns = monotonic_ns();
+  clock_recovery.checked_ns = clock_recovery.started_ns;
+  if (!clock_recovery.started_ns) {
+    clock_recovery.result = EIO;
+    return EIO;
+  }
+  for (batch = 0; batch < SHIRI_CLOCK_RECOVERY_BATCHES; batch++) {
+    int result = clock_recovery_deadline();
+    uint64_t entered_ns = clock_recovery.checked_ns;
+    if (result) return result;
+    result = sample_clocks(packet);
+    clock_recovery.batches++;
+    clock_recovery.last_batch_result = result;
+    if (result == ETIMEDOUT) {
+      clock_recovery.refused++;
+      if (refused_batches < UINT64_MAX) refused_batches++;
+    } else if (result) {
+      clock_recovery.result = result;
+      return result; /* Invalid/backwards/read failures are never retryable. */
+    }
+    /* A valid narrow pair cannot waive either the original entry deadline or
+     * monotonic ordering across the surrounding recovery transaction. */
+    if (!result && (packet->mono_before < entered_ns ||
+                    packet->mono_after < packet->mono_before)) {
+      clock_recovery.result = EIO;
+      return EIO;
+    }
+    if (clock_recovery_deadline()) return clock_recovery.result;
+    if (!result && packet->mono_after > clock_recovery.checked_ns) {
+      clock_recovery.result = EIO;
+      return EIO;
+    }
+    if (!result) return 0;
+  }
+  clock_recovery.result = ETIMEDOUT;
+  return ETIMEDOUT;
+}
+
+static void clock_recovery_sent(void) {
+  if (!clock_recovery.refused) return;
+  if (recovered_packets < UINT64_MAX) recovered_packets++;
+  /* At most 64 summaries per exact session, rather than a log per PCM block. */
+  if (recovered_packets == 1 || !(recovered_packets & (recovered_packets - 1)))
+    warn("Shiri native PCM clock recovered: packets=%llu refused_batches=%llu "
+         "batches=%u refused=%u elapsed_ns=%llu; original PCM retained.",
+         (unsigned long long)recovered_packets, (unsigned long long)refused_batches,
+         clock_recovery.batches, clock_recovery.refused,
+         (unsigned long long)clock_recovery.elapsed_ns);
 }
