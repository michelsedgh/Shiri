+/* Count only samples whose original integer first-sample calendar has elapsed.
+ * Compare the last sample before multiplying, bounding the ceil numerator by
+ * the validated packet duration. Equality with NOW is not future admission. */
+static uint32_t expired_prefix(uint64_t presentation, uint64_t now, uint32_t frames) {
+  uint64_t delta, last;
+  if (!frames || now < presentation) return 0;
+  delta = now - presentation;
+  last = (uint64_t)(frames - 1u) * UINT64_C(1000000000) / SHIRI_PCM_RATE;
+  if (delta >= last) return frames;
+  return (uint32_t)(((delta + 1u) * SHIRI_PCM_RATE + UINT64_C(999999999)) /
+                    UINT64_C(1000000000));
+}
