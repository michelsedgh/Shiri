+/* Failed timer arming may retire only its exact current input binding. */
+int
+input_pipe_shiri_disarm(const struct shiri_pcm_owner *owner, uint64_t operation_generation)
+{
+  int ret = -1;
+  if (!owner)
+    return -1;
+  pthread_mutex_lock(&shiri_gate_lock);
+  if (operation_generation == shiri_operation
+      && owner->epoch == shiri_owner.epoch && owner->generation == shiri_owner.generation
+      && !memcmp(owner->incarnation, shiri_owner.incarnation, 16)
+      && !memcmp(owner->session, shiri_owner.session, 16))
+    {
+      shiri_armed = false;
+      ret = 0;
+    }
+  pthread_mutex_unlock(&shiri_gate_lock);
+  return ret;
+}
