+/* Preserve the rejected original anchor and operation in diagnostics. */
+static int
+pb_timer_native_reject(const char *reason, int state, uint64_t operation,
+                       struct timespec anchor, struct timespec now)
+{
+  DPRINTF(E_LOG, L_PLAYER,
+          "Native anchor rejected: reason=%s state=%d operation=%" PRIu64
+          " timer_operation=%" PRIu64 " anchor=%jd.%09ld now=%jd.%09ld wait_until=%jd.%09ld\n",
+          reason, state, operation, pb_timer_native_operation,
+          (intmax_t)anchor.tv_sec, anchor.tv_nsec, (intmax_t)now.tv_sec, now.tv_nsec,
+          (intmax_t)pb_timer_native_wait_until.tv_sec, pb_timer_native_wait_until.tv_nsec);
+  return -1;
+}
+
 /* 1 means this tick may consume PCM; 0 waits on the same bounded existing
  * timer. This function never creates an independent output scheduler. */
 static int
 pb_timer_native_prepare(void)
 {
   struct itimerspec tick;
-  struct timespec now, anchor;
+  struct timespec now = { 0 }, anchor = { 0 };
   uint64_t operation;
   int state, ret;
   state = input_pipe_shiri_state(&operation);
   if (state != 1 || operation != pb_timer_native_operation)
-    return -1;
+    return pb_timer_native_reject("source_gate", state, operation, anchor, now);
   if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
-    return -1;
+    return pb_timer_native_reject("clock_read", state, operation, anchor, now);
   if (pb_timer_native_anchored)
     return timespec_cmp(now, pb_timer_native_anchor) < 0 ? 0 : 1;
   ret = input_peek_sync(&anchor);
   /* The input mutex can wait across the native deadline. Admit the original
    * anchor against a fresh clock after peek, including a missing marker. */
-  if (ret < 0 || clock_gettime(CLOCK_MONOTONIC, &now) < 0
-      || timespec_cmp(now, pb_timer_native_wait_until) >= 0)
-    return -1;
+  if (ret < 0)
+    return pb_timer_native_reject("anchor_peek", state, operation, anchor, now);
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+    return pb_timer_native_reject("anchor_clock_read", state, operation, anchor, now);
+  if (timespec_cmp(now, pb_timer_native_wait_until) >= 0)
+    return pb_timer_native_reject("anchor_timeout", state, operation, anchor, now);
   if (!ret)
     return 0;
   /* Never replace a late native anchor with the receive or timer clock. */
   if (timespec_cmp(anchor, now) <= 0)
-    return -1;
+    return pb_timer_native_reject("anchor_late", state, operation, anchor, now);
   tick.it_interval = player_tick_interval;
