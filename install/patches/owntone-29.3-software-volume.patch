+/* Keep every buffered block raw until submission. Gain changes neither the
+ * source buffer nor frame counts, timestamps, queue state or synchronization.
+ */
+static snd_pcm_sframes_t
+pcm_write(struct alsa_playback_session *pb, const uint8_t *buf, snd_pcm_sframes_t nsamp)
+{
+  struct alsa_session *as = pb->session;
+  uint8_t *allocated;
+  ssize_t bytes;
+  size_t frame_bytes;
+
+  if (!as->software_volume)
+    return snd_pcm_writei(pb->pcm, buf, nsamp);
+  if (nsamp < 0 || pb->quality.channels <= 0
+      || (pb->quality.bits_per_sample != 16 && pb->quality.bits_per_sample != 24
+          && pb->quality.bits_per_sample != 32))
+    return -EINVAL;
+  if (nsamp == 0)
+    return 0;
+  if ((size_t)pb->quality.channels > SIZE_MAX / (pb->quality.bits_per_sample / 8))
+    return -EINVAL;
+  frame_bytes = (size_t)(pb->quality.bits_per_sample / 8) * pb->quality.channels;
+  if ((uint64_t)nsamp > (uint64_t)SSIZE_MAX / frame_bytes)
+    return -EINVAL;
+  bytes = snd_pcm_frames_to_bytes(pb->pcm, nsamp);
+  if (bytes < 0 || (size_t)bytes != (size_t)nsamp * frame_bytes)
+    return -EINVAL;
+  if ((size_t)bytes > pb->volume_bufsize)
+    {
+      allocated = realloc(pb->volume_buf, bytes);
+      if (!allocated)
+        return -ENOMEM;
+      pb->volume_buf = allocated;
+      pb->volume_bufsize = bytes;
+    }
+  if (pcm_volume_scale_copy(pb->volume_buf, buf, bytes, pb->quality.bits_per_sample, as->volume) < 0)
+    return -EINVAL;
+
+  return snd_pcm_writei(pb->pcm, pb->volume_buf, nsamp);
+}
