diff --git a/src/outputs/pcm_volume.h b/src/outputs/pcm_volume.h
new file mode 100644
index 00000000..3ac5a64d
--- /dev/null
+++ b/src/outputs/pcm_volume.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OWNTONE_PCM_VOLUME_H
+#define OWNTONE_PCM_VOLUME_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline int
+pcm_volume_clamp(int volume)
+{
+  return volume < 0 ? 0 : volume > 100 ? 100 : volume;
+}
+
+/* Copy interleaved signed LE PCM to private storage, with cubic percent gain.
+ * The caller owns the byte capacities. Reject overlap and incomplete samples;
+ * neither the shared output nor the raw prebuffer is ever scaled in place.
+ */
+static inline int
+pcm_volume_scale_copy(uint8_t *dst, const uint8_t *src, size_t bytes,
+                      unsigned int bits, int volume)
+{
+  uintptr_t dst_addr = (uintptr_t)dst;
+  uintptr_t src_addr = (uintptr_t)src;
+  uint64_t raw, encoded;
+  int64_t sample, scaled;
+  int64_t gain;
+  size_t offset;
+  unsigned int width, byte;
+
+  if (bits != 16 && bits != 24 && bits != 32)
+    return -1;
+  width = bits / 8;
+  if (bytes % width != 0)
+    return -1;
+  if (bytes == 0)
+    return 0;
+  if (!dst || !src || bytes > UINTPTR_MAX - dst_addr || bytes > UINTPTR_MAX - src_addr)
+    return -1;
+  if (dst_addr < src_addr + bytes && src_addr < dst_addr + bytes)
+    return -1;
+
+  volume = pcm_volume_clamp(volume);
+  if (volume == 100)
+    {
+      memcpy(dst, src, bytes);
+      return 0;
+    }
+  if (volume == 0)
+    {
+      memset(dst, 0, bytes);
+      return 0;
+    }
+
+  gain = (int64_t)volume * volume * volume;
+  for (offset = 0; offset < bytes; offset += width)
+    {
+      raw = 0;
+      for (byte = 0; byte < width; byte++)
+        raw |= (uint64_t)src[offset + byte] << (byte * 8);
+      sample = (raw & (UINT64_C(1) << (bits - 1)))
+        ? (int64_t)raw - (INT64_C(1) << bits) : (int64_t)raw;
+      /* int32 extrema times 100^3 fit int64. Division truncates toward zero. */
+      scaled = sample * gain / INT64_C(1000000);
+      encoded = (uint64_t)scaled;
+      for (byte = 0; byte < width; byte++)
+        dst[offset + byte] = (uint8_t)(encoded >> (byte * 8));
+    }
+  return 0;
+}
+
+#endif
