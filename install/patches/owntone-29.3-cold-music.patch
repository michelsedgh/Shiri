+/* A sample-based sync cadence does not advance during an empty input. A
+ * framed source's new original timestamp after that gap needs a fresh mapping
+ * before its first payload, even if fewer than one second of samples arrived.
+ * Raw sample spacing avoids resampler startup and converted-count rounding. */
 static void
-packets_sync_send(struct airplay_master_session *ams)
+airplay_shiri_input_timestamp(struct airplay_master_session *ams, struct output_buffer *obuf)
+{
+  struct output_data *raw = &obuf->data[0];
+  struct timespec duration, tolerance;
+  uint64_t sample_ns;
+  int direction;
+  if (!cfg_getbool(cfg_getsec(cfg, "library"), "pipe_framed") ||
+      obuf->conversion_error || raw->samples <= 0 || raw->quality.sample_rate <= 0)
+    return;
+  /* Changes below one source sample cannot change the represented sample
+   * position. This also absorbs integer floors and mapped-clock noise. */
+  sample_ns = (UINT64_C(1000000000) + raw->quality.sample_rate - 1) /
+    raw->quality.sample_rate;
+  tolerance.tv_sec = sample_ns / UINT64_C(1000000000);
+  tolerance.tv_nsec = sample_ns % UINT64_C(1000000000);
+  if (ams->shiri_input_end_valid &&
+      (timespec_cmp(obuf->pts, timespec_add(ams->shiri_input_end, tolerance)) > 0 ||
+       timespec_cmp(ams->shiri_input_end, timespec_add(obuf->pts, tolerance)) > 0))
+    {
+      direction = timespec_cmp(obuf->pts, ams->shiri_input_end);
+      ams->shiri_sync_pending = true;
+      DPRINTF(E_DBG, L_AIRPLAY,
+              "Framed AirPlay timestamp discontinuity: direction=%s end=%jd.%09ld next=%jd.%09ld\n",
+              direction > 0 ? "forward" : "backward",
+              (intmax_t)ams->shiri_input_end.tv_sec, ams->shiri_input_end.tv_nsec,
+              (intmax_t)obuf->pts.tv_sec, obuf->pts.tv_nsec);
+    }
+  duration.tv_sec = raw->samples / raw->quality.sample_rate;
+  duration.tv_nsec = UINT64_C(1000000000) * (raw->samples % raw->quality.sample_rate) /
+    raw->quality.sample_rate;
+  ams->shiri_input_end = timespec_add(obuf->pts, duration);
+  ams->shiri_input_end_valid = true;
+}
