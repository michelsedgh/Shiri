+static int metadata_fence(void *context) {
+  // The principal read lock owns this pointer for the complete exchange.
+  // Metadata precedes native BEGIN, so it has no worker/source generation.
+  return principal_conn == (rtsp_conn_info *)context;
+}
+ssize_t shiri_ap2_event_exchange(rtsp_conn_info *conn,const char *data,size_t data_length) {
+  uint64_t now=shiri_volume_now(),deadline=now+UINT64_C(750000000);
+  int ret=SHIRI_VOLUME_UNAVAILABLE, principal_locked=0,event_locked=0,cancel_state;
+  if (!conn || !data || !data_length || data_length>65536 || !now) return -1;
+  // Cancellation is delayed only for this <=750ms transaction. Every heap
+  // allocation and lock retires before restoring it; an outer AP2 receiver
+  // cleanup may then run without leaked buffers or half-owned cipher state.
+  if (pthread_setcancelstate(PTHREAD_CANCEL_DISABLE,&cancel_state)) return -1;
+  for (;;) {
+    int result=pthread_rwlock_tryrdlock(&principal_conn_lock);
+    if (!result) { principal_locked=1; break; }
+    if (result!=EBUSY && result!=EAGAIN) goto done;
+    if (!shiri_volume_now() || shiri_volume_now()>=deadline) goto done;
+    poll(NULL,0,5);
+  }
+  if (!metadata_fence(conn) || conn->airplay_type!=ap_2) goto done;
+  ret=volume_mutex(&conn->event_sender_mutex,deadline,metadata_fence,conn);
+  if (ret) goto done;
+  event_locked=1;
+  // The pinned metadata request carries no CSeq. Its single in-flight reply
+  // may omit or include one; identified volume commands remain exact below.
+  ret=volume_exchange(conn,data,data_length,0,deadline,metadata_fence,conn);
+done:
+  if (event_locked) pthread_mutex_unlock(&conn->event_sender_mutex);
+  if (principal_locked) pthread_rwlock_unlock(&principal_conn_lock);
+  pthread_setcancelstate(cancel_state,NULL);
+  return ret==SHIRI_VOLUME_OK ? (ssize_t)data_length : -1;
 }
