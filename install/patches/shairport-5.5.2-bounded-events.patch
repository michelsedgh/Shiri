+/* Admit only whole pinned HomeKit records. The upstream decoder rejects a
+ * one-byte initial header and otherwise reads two bytes past a trailing single
+ * byte. Authentication and cipher counters remain in pair_decrypt itself. */
+static int volume_complete_records(const uint8_t *data,size_t length,size_t *complete) {
+  size_t at=0;
+  while (length-at>=2) {
+    size_t block=(size_t)data[at]|((size_t)data[at+1]<<8);
+    if (!block || block>1024) return -1;
+    if (length-at<block+18) break;
+    at+=block+18;
+  }
+  *complete=at;
+  return 0;
