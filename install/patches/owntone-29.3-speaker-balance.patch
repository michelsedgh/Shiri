 int
 outputs_volume_set(int volume, output_status_cb cb)
 {
   struct output_device *device;
   int pending = 0;
   int ret;
 
   if (outputs_master_volume == volume)
     return 0;
 
   outputs_master_volume = volume;
 
   for (device = outputs_device_list; device; device = device->next)
     {
       if (!device->selected)
 	continue;
 
       device->volume = rel_to_vol(device->relvol, outputs_master_volume);
 
       ret = outputs_device_volume_set(device, cb);
       if (ret < 0)
 	continue;
 
       pending += ret;
     }
 
   return pending;
 }
 
 int
+outputs_shiri_volume_settings_set(const struct shiri_volume_settings *settings, output_status_cb cb)
+{
+  struct output_device *device;
+  size_t i, j;
+  int volume, ret, pending = 0;
+  if (!settings || settings->volume < 0 || settings->volume > 100 || settings->count > SHIRI_VOLUME_OUTPUTS_MAX)
+    return -1;
+  /* Validate the complete request before altering any gain or master state. */
+  for (i = 0; i < settings->count; i++)
+    {
+      if (settings->outputs[i].balance_percent < 0 || settings->outputs[i].balance_percent > 100
+          || !outputs_device_get(settings->outputs[i].id))
+        return -1;
+      for (j = 0; j < i; j++)
+        if (settings->outputs[i].id == settings->outputs[j].id)
+          return -1;
+    }
+  for (i = 0; i < settings->count; i++)
+    {
+      device = outputs_device_get(settings->outputs[i].id);
+      device->shiri_balance_percent = settings->outputs[i].balance_percent;
+      device->shiri_balance_set = true;
+    }
+  shiri_volume_settings_active = true;
+  shiri_saved_volume_settings = *settings;
+  outputs_master_volume = settings->volume;
+  for (device = outputs_device_list; device; device = device->next)
+    {
+      device->relvol = device->shiri_balance_set ? device->shiri_balance_percent : 100;
+      volume = shiri_balanced_volume(outputs_master_volume, device->relvol);
+      if (device->volume == volume)
+        continue;
+      device->volume = volume;
+      if (!device->selected)
+        continue;
+      ret = outputs_device_volume_set(device, cb);
+      if (ret > 0)
+        pending += ret;
+    }
+  return pending;
+}
