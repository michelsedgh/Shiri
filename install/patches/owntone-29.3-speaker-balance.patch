+  body = jparse_obj_from_evbuffer(hreq->in_body);
+  if (shiri_volume_settings_parse(body, &settings) < 0)
+    {
+      if (body) json_object_put(body);
+      return HTTP_BADREQUEST;
+    }
+  ret = player_shiri_volume_settings(&settings);
+  if (ret < 0)
+    {
+      json_object_put(body);
+      return HTTP_SERVUNAVAIL;
+    }
+  reply = json_object_to_json_string_ext(body, JSON_C_TO_STRING_PLAIN);
+  evbuffer_add(hreq->out_body, reply, strlen(reply));
+  json_object_put(body);
+  return HTTP_OK;
+}
