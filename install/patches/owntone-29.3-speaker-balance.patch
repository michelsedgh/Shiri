 int
 outputs_shiri_start(output_status_cb cb, int *failed)
 {
   struct output_device *device;
   int ret, pending = 0;
   *failed = 0;
   for (device = outputs_device_list; device; device = device->next)
     {
       if (!device->selected)
         continue;
       ret = outputs_device_start(device, cb, false);
       if (ret < 0)
         *failed = 1;
       else
         pending += ret;
     }
   return pending;
 }
 
