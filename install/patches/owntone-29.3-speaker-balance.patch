diff --git a/src/shiri_volume_settings_json.h b/src/shiri_volume_settings_json.h
new file mode 100644
--- /dev/null
+++ b/src/shiri_volume_settings_json.h
@@ -0,0 +1,60 @@
+#ifndef SHIRI_VOLUME_SETTINGS_JSON_H
+#define SHIRI_VOLUME_SETTINGS_JSON_H
+#include <string.h>
+#include <json-c/json.h>
+#include "shiri_volume_settings.h"
+static inline int
+shiri_volume_settings_parse(json_object *body, struct shiri_volume_settings *settings)
+{
+  json_object *volume, *outputs, *entry, *id, *balance;
+  const char *text;
+  uint64_t value;
+  size_t i, j, length;
+  int64_t number;
+  if (!body || json_object_get_type(body) != json_type_object
+      || json_object_object_length(body) != 2
+      || !json_object_object_get_ex(body, "volume", &volume)
+      || json_object_get_type(volume) != json_type_int
+      || !json_object_object_get_ex(body, "outputs", &outputs)
+      || json_object_get_type(outputs) != json_type_array)
+    return -1;
+  number = json_object_get_int64(volume);
+  if (number < 0 || number > 100)
+    return -1;
+  settings->volume = (int)number;
+  settings->count = json_object_array_length(outputs);
+  if (settings->count > SHIRI_VOLUME_OUTPUTS_MAX)
+    return -1;
+  for (i = 0; i < settings->count; i++)
+    {
+      entry = json_object_array_get_idx(outputs, i);
+      if (!entry || json_object_get_type(entry) != json_type_object
+          || json_object_object_length(entry) != 2
+          || !json_object_object_get_ex(entry, "id", &id)
+          || json_object_get_type(id) != json_type_string
+          || !json_object_object_get_ex(entry, "balance_percent", &balance)
+          || json_object_get_type(balance) != json_type_int)
+        return -1;
+      text = json_object_get_string(id);
+      length = json_object_get_string_len(id);
+      if (length == 0 || length > 20 || strlen(text) != length || (length > 1 && text[0] == '0'))
+        return -1;
+      value = 0;
+      for (j = 0; j < length; j++)
+        {
+          if (text[j] < '0' || text[j] > '9' || value > (UINT64_MAX - (text[j] - '0')) / 10)
+            return -1;
+          value = value * 10 + (text[j] - '0');
+        }
+      for (j = 0; j < i; j++)
+        if (settings->outputs[j].id == value)
+          return -1;
+      number = json_object_get_int64(balance);
+      if (number < 0 || number > 100)
+        return -1;
+      settings->outputs[i].id = value;
+      settings->outputs[i].balance_percent = (int)number;
+    }
+  return 0;
+}
+#endif
