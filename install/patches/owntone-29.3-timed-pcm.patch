+          ret = (timestamp->tv_sec < 0 || timestamp->tv_nsec < 0 ||
+                 timestamp->tv_nsec >= 1000000000L) ? -1 : 1;
+        }
+      break;
+    }
+  if (!ret && evbuffer_get_length(input_buffer.evbuf))
+    ret = -1;
+  pthread_mutex_unlock(&input_buffer.mutex);
+  return ret;
+}
