+int
+input_pipe_shiri_seal(uint64_t operation_generation)
+{
+  uint8_t discarded[4096];
+  size_t drained = 0;
+  ssize_t n;
+  struct pipe *pipe;
+  if (!pipe_framed || !operation_generation || operation_generation > INT64_MAX)
+    return -1;
+  pthread_mutex_lock(&shiri_gate_lock);
+  if (operation_generation <= shiri_operation)
+    {
