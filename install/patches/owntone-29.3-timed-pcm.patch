+int
+input_peek_sync(struct timespec *timestamp)
+{
+  struct marker *marker;
+  int ret = 0;
+  pthread_mutex_lock(&input_buffer.mutex);
+  for (marker = input_buffer.marker_tail; marker; marker = marker->prev)
+    {
+      if (marker->flag != INPUT_FLAG_SYNC)
+        continue;
+      /* A start/resume must never assign a later anchor to preceding PCM. */
+      if (!marker->data || marker->pos != input_buffer.bytes_read)
+        ret = -1;
+      else
+        {
