 int ba_transport_pcm_drain(struct ba_transport_pcm *pcm) {
 
 	pthread_mutex_lock(&pcm->mutex);
 
 	if (!ba_transport_pcm_state_check_running(pcm)) {
 		pthread_mutex_unlock(&pcm->mutex);
 		return errno = ESRCH, -1;
 	}
 
 	debug("PCM drain: %d", pcm->fd);
 
 	pcm->drained = false;
 	ba_transport_pcm_signal_send(pcm, BA_TRANSPORT_PCM_SIGNAL_DRAIN);
 
 	while (!pcm->drained)
 		pthread_cond_wait(&pcm->cond, &pcm->mutex);
 
 	pthread_mutex_unlock(&pcm->mutex);
 
 	/* TODO: Asynchronous transport release.
 	 *
 	 * Unfortunately, BlueZ does not provide API for internal buffer drain.
 	 * Also, there is no specification for Bluetooth playback drain. In order
 	 * to make sure, that all samples are played out, we have to wait some
 	 * arbitrary time before releasing transport. In order to make it right,
 	 * there is a requirement for an asynchronous release mechanism, which
 	 * is not implemented - it requires a little bit of refactoring. */
 	usleep(200000);
 
 	debug("PCM drained");
 	return 0;
 }
 
 int ba_transport_pcm_drop(struct ba_transport_pcm *pcm) {
 
 #if DEBUG
 	pthread_mutex_lock(&pcm->mutex);
 	debug("PCM drop: %d", pcm->fd);
 	pthread_mutex_unlock(&pcm->mutex);
 #endif
 
 	int rv = ba_transport_pcm_signal_send(pcm, BA_TRANSPORT_PCM_SIGNAL_DROP);
 	if (rv == -1 && errno == ESRCH) {
 		/* If the transport thread is not running flush the PCM here. */
 		io_pcm_flush(pcm);
 		rv = 0;
 	}
 
 	return rv;
 }
 
+/* The capability deliberately covers only the reviewed SBC encoder seam. */
+bool ba_transport_pcm_drop_sync_supported(struct ba_transport_pcm *pcm) {
+	return pcm->mode == BA_TRANSPORT_PCM_MODE_SINK &&
+		pcm->t->profile == BA_TRANSPORT_PROFILE_A2DP_SOURCE &&
+		ba_transport_get_codec(pcm->t) == A2DP_CODEC_SBC;
+}
+
+void ba_transport_pcm_drop_sync_cancel(struct ba_transport_pcm *pcm) {
+	if (!pcm->drop_sync_initialized)
+		return;
+	pthread_mutex_lock(&pcm->drop_sync_mtx);
+	pcm->drop_sync_active = 0;
+	pcm->drop_sync_result = ECANCELED;
+	pthread_cond_broadcast(&pcm->drop_sync_cond);
+	pthread_mutex_unlock(&pcm->drop_sync_mtx);
+}
+
+struct drop_sync_waiter { struct ba_transport_pcm *pcm; uint64_t token; };
+
+static void drop_sync_wait_cancel(void *userdata) {
+	struct drop_sync_waiter *waiter = userdata;
+	struct ba_transport_pcm *pcm = waiter->pcm;
+	/* pthread_cond_timedwait reacquires this mutex before cancellation. */
+	if (pcm->drop_sync_active == waiter->token) {
+		pcm->drop_sync_active = 0;
+		pcm->drop_sync_result = ECANCELED;
+	}
+	pthread_cond_broadcast(&pcm->drop_sync_cond);
+	pthread_mutex_unlock(&pcm->drop_sync_mtx);
+}
+
+/* pthread_mutex_lock has no monotonic deadline. Try-lock retries do not claim
+ * completion; only actually acquiring the mutex before the deadline does. */
+int ba_transport_pcm_drop_sync_lock(pthread_mutex_t *mutex, const struct timespec *deadline) {
+	for (;;) {
+		struct timespec now;
+		if (clock_gettime(CLOCK_MONOTONIC, &now) == -1)
+			return EIO;
+		if (now.tv_sec > deadline->tv_sec ||
+				(now.tv_sec == deadline->tv_sec && now.tv_nsec >= deadline->tv_nsec))
+			return ETIMEDOUT;
+		int error = pthread_mutex_trylock(mutex);
+		if (error != EBUSY)
+			return error;
+		struct timespec retry = { .tv_sec = 0, .tv_nsec = 1000000 };
+		if (nanosleep(&retry, NULL) == -1 && errno != EINTR)
+			return EIO;
+	}
+}
+
+int ba_transport_pcm_drop_sync(struct ba_transport_pcm *pcm) {
+	/* glibc cleanup handlers may use setjmp: preserve the result across that scope. */
+	volatile int error = 0;
+	uint64_t token;
+	struct timespec deadline;
+	if (!ba_transport_pcm_drop_sync_supported(pcm))
+		return errno = ENOTSUP, -1;
+	if (clock_gettime(CLOCK_MONOTONIC, &deadline) == -1)
+		return -1;
+	/* Leave 50 ms of the client's 200 ms budget for controller delivery. */
+	deadline.tv_nsec += 150000000;
+	if (deadline.tv_nsec >= 1000000000) {
+		deadline.tv_sec++;
+		deadline.tv_nsec -= 1000000000;
+	}
+
+	int old_cancel_state;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &old_cancel_state);
+
+	/* Establish the request while release/reopen of the selected pipe is excluded.
+	 * Everywhere acquiring both locks takes PCM mutex before drop_sync_mtx. */
+	error = ba_transport_pcm_drop_sync_lock(&pcm->mutex, &deadline);
+	if (error != 0) {
+		pthread_setcancelstate(old_cancel_state, NULL);
+		return errno = error, -1;
+	}
+	error = ba_transport_pcm_drop_sync_lock(&pcm->drop_sync_mtx, &deadline);
+	if (error != 0) {
+		pthread_mutex_unlock(&pcm->mutex);
+		pthread_setcancelstate(old_cancel_state, NULL);
+		return errno = error, -1;
+	}
+	if (pcm->drop_sync_active != 0)
+		error = EBUSY;
+	else if (pcm->fd == -1 || !ba_transport_pcm_state_check_running(pcm))
+		error = ESRCH;
+	else if (pcm->drop_sync_next == UINT64_MAX)
+		error = EOVERFLOW;
+	if (error != 0) {
+		pthread_mutex_unlock(&pcm->drop_sync_mtx);
+		pthread_mutex_unlock(&pcm->mutex);
+		pthread_setcancelstate(old_cancel_state, NULL);
+		return errno = error, -1;
+	}
+	token = ++pcm->drop_sync_next;
+	pcm->drop_sync_active = token;
+	pcm->drop_sync_fd = pcm->fd;
+	pcm->drop_sync_deadline = deadline;
+	pcm->drop_sync_result = EINPROGRESS;
+	ssize_t written;
+	do written = write(pcm->drop_sync_pipe[1], &token, sizeof(token));
+	while (written == -1 && errno == EINTR);
+	if (written != sizeof(token)) {
+		error = written == -1 ? errno : EIO;
+		pcm->drop_sync_active = 0;
+	}
+	pthread_mutex_unlock(&pcm->mutex);
+
+	struct drop_sync_waiter waiter = { pcm, token };
+	pthread_cleanup_push(drop_sync_wait_cancel, &waiter);
+	pthread_setcancelstate(old_cancel_state, NULL);
+	while (error == 0 && pcm->drop_sync_active == token &&
+			pcm->drop_sync_result == EINPROGRESS) {
+		error = pthread_cond_timedwait(&pcm->drop_sync_cond, &pcm->drop_sync_mtx, &deadline);
+	}
+	if (error == 0)
+		error = pcm->drop_sync_active == token ? pcm->drop_sync_result : ECANCELED;
+	if (error == 0) {
+		struct timespec now;
+		if (clock_gettime(CLOCK_MONOTONIC, &now) == -1)
+			error = EIO;
+		else if (now.tv_sec > deadline.tv_sec ||
+				(now.tv_sec == deadline.tv_sec && now.tv_nsec >= deadline.tv_nsec))
+			error = ETIMEDOUT;
+	}
+	if (pcm->drop_sync_active == token)
+		pcm->drop_sync_active = 0;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, NULL);
+	pthread_cleanup_pop(0);
+	pthread_mutex_unlock(&pcm->drop_sync_mtx);
+	pthread_setcancelstate(old_cancel_state, NULL);
+	if (error != 0)
+		return errno = error, -1;
+	return 0;
+}
+
+bool ba_transport_pcm_drop_sync_claim(struct ba_transport_pcm *pcm, uint64_t token,
+		int *fd, struct timespec *deadline) {
+	pthread_mutex_lock(&pcm->drop_sync_mtx);
+	bool valid = token != 0 && pcm->drop_sync_active == token &&
+		pcm->drop_sync_result == EINPROGRESS;
+	if (valid) {
+		*fd = pcm->drop_sync_fd;
+		*deadline = pcm->drop_sync_deadline;
+	}
+	pthread_mutex_unlock(&pcm->drop_sync_mtx);
+	return valid;
+}
+
+void ba_transport_pcm_drop_sync_complete(struct ba_transport_pcm *pcm, uint64_t token, int error) {
+	pthread_mutex_lock(&pcm->drop_sync_mtx);
+	if (token != 0 && pcm->drop_sync_active == token && pcm->drop_sync_result == EINPROGRESS) {
+		struct timespec now;
+		if (clock_gettime(CLOCK_MONOTONIC, &now) == -1)
+			error = EIO;
+		else if (now.tv_sec > pcm->drop_sync_deadline.tv_sec ||
+				(now.tv_sec == pcm->drop_sync_deadline.tv_sec && now.tv_nsec >= pcm->drop_sync_deadline.tv_nsec))
+			error = ETIMEDOUT;
+		pcm->drop_sync_result = error;
+		pthread_cond_broadcast(&pcm->drop_sync_cond);
+	}
+	pthread_mutex_unlock(&pcm->drop_sync_mtx);
+}
+
 int ba_transport_pcm_signal_send(
 		struct ba_transport_pcm *pcm,
 		enum ba_transport_pcm_signal signal) {
 
 	int ret = -1;
 
 	pthread_mutex_lock(&pcm->state_mtx);
 
 	if (pcm->state != BA_TRANSPORT_PCM_STATE_RUNNING) {
 		errno = ESRCH;
 		goto fail;
 	}
 
 	if (write(pcm->pipe[1], &signal, sizeof(signal)) != sizeof(signal)) {
 		warn("Couldn't write transport PCM signal: %s", strerror(errno));
 		goto fail;
 	}
 
 	ret = 0;
 
 fail:
 	pthread_mutex_unlock(&pcm->state_mtx);
 	return ret;
 }
 
 /**
  * Receive signal sent by ba_transport_pcm_signal_send().
  *
  * @note
  * In case of error, this function will return -1 instead of signal value. */
 enum ba_transport_pcm_signal ba_transport_pcm_signal_recv(
 		struct ba_transport_pcm *pcm) {
 
 	enum ba_transport_pcm_signal signal;
 	ssize_t ret;
 
 	while ((ret = read(pcm->pipe[0], &signal, sizeof(signal))) == -1 &&
 			errno == EINTR)
 		continue;
 
 	if (ret == sizeof(signal))
 		return signal;
 
 	warn("Couldn't read transport PCM signal: %s", strerror(errno));
 	return -1;
 }
 
 bool ba_transport_pcm_is_active(const struct ba_transport_pcm *pcm) {
 	pthread_mutex_lock(MUTABLE(&pcm->mutex));
 	bool active = pcm->fd != -1 && !pcm->paused;
 	pthread_mutex_unlock(MUTABLE(&pcm->mutex));
 	return active;
 }
 
 /**
  * Convert PCM volume level to [0, max] range. */
 unsigned int ba_transport_pcm_volume_level_to_range(int value, int max) {
 	int volume = audio_decibel_to_loudness(value / 100.0) * max;
 	return MIN(MAX(volume, 0), max);
 }
 
 /**
  * Convert [0, max] range to PCM volume level. */
 int ba_transport_pcm_volume_range_to_level(int value, int max) {
 	int level = audio_loudness_to_decibel(1.0 * value / max) * 100;
 	return MIN(MAX(level, -9600), 9600);
 }
 
 /**
  * Set PCM volume level/mute.
  *
  * One shall use this function instead of directly writing to PCM volume
  * structure fields.
  *
  * @param level If not NULL, new PCM volume level in "dB * 100".
  * @param soft_mute If not NULL, change software mute state.
  * @param hard_mute If not NULL, change hardware mute state. */
 void ba_transport_pcm_volume_set(
 		struct ba_transport_pcm_volume *volume,
 		const int *level,
 		const bool *soft_mute,
 		const bool *hard_mute) {
 
 	if (level != NULL)
 		volume->level = *level;
 	/* Allow software mute state modifications only if hardware mute
 	 * was not enabled or we are updating software and hardware mute
 	 * at the same time. */
 	if (soft_mute != NULL &&
 			(!volume->hard_mute || hard_mute != NULL))
 		volume->soft_mute = *soft_mute;
 	if (hard_mute != NULL)
 		volume->hard_mute = *hard_mute;
 
 	/* calculate PCM scale factor */
 	const bool muted = volume->soft_mute || volume->hard_mute;
 	volume->scale = muted ? 0 : pow(10, (0.01 * volume->level) / 20);
 
 }
 
 /**
  * Synchronize PCM volume level.
  *
  * This function notifies remote Bluetooth device and D-Bus clients. */
 int ba_transport_pcm_volume_sync(struct ba_transport_pcm *pcm, unsigned int update_mask) {
 
 	struct ba_transport *t = pcm->t;
 
 	/* In case of A2DP Source or HSP/HFP Audio Gateway skip notifying Bluetooth
 	 * device if we are using software volume control. This will prevent volume
 	 * double scaling - firstly by us and then by Bluetooth headset/speaker. */
 	if (pcm->soft_volume && t->profile & (
 				BA_TRANSPORT_PROFILE_A2DP_SOURCE | BA_TRANSPORT_PROFILE_MASK_AG))
 		goto final;
 
 	if (BA_TRANSPORT_PROFILE_IS_MEDIA(t)) {
 
 		/* A2DP specification defines volume property as a single value - volume
 		 * for only one channel. For multi-channel audio, we will use calculated
 		 * average volume level. */
 
 		int level_sum = 0;
 		for (size_t i = 0; i < pcm->channels; i++)
 			level_sum += pcm->volume[i].level;
 
 		/* Volume rage for A2DP and ASHA is the same. */
 		uint16_t volume = ba_transport_pcm_volume_level_to_range(
 				level_sum / (int)pcm->channels, BLUEZ_MEDIA_TRANSPORT_A2DP_VOLUME_MAX);
 
 		/* Skip update if nothing has changed. */
 		if (volume != t->media.volume) {
 
 			GError * err = NULL;
 			t->media.volume = volume;
 			g_dbus_set_property_sync(config.dbus, t->bluez_dbus_owner, t->bluez_dbus_path,
 					BLUEZ_IFACE_MEDIA_TRANSPORT, "Volume", g_variant_new_uint16(volume), &err);
 
 			if (err != NULL) {
 				warn("Couldn't set BT device volume: %s", err->message);
 				g_error_free(err);
 			}
 
 		}
 
 	}
 	else if (BA_TRANSPORT_PROFILE_IS_SCO(t)) {
 
 		if (t->sco.rfcomm != NULL)
 			/* notify associated RFCOMM transport */
 			ba_rfcomm_send_signal(t->sco.rfcomm, BA_RFCOMM_SIGNAL_UPDATE_VOLUME);
 #if ENABLE_OFONO
 		else
 			ofono_call_volume_update(t);
 #endif
 
 	}
 
 final:
 	/* Notify all connected D-Bus clients. */
 	bluealsa_dbus_pcm_update(pcm, update_mask);
 	return 0;
 }
 
