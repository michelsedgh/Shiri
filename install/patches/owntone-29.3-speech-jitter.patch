+/* Diagnostic reads execute on the same player thread as ingress/mix/source
+ * fencing. Copy the current source binding without mutating any media state. */
+static enum command_state
+shiri_speech_status_get(void *arg, int *retval)
+{
+  struct player_shiri_speech_status *out = arg;
+  shiri_speech_status(&out->media);
+  out->source = shiri_source_state.last;
+  out->source_initialized = shiri_source_state.initialized;
+  out->source_faulted = shiri_source_state.faulted;
+  *retval = out->media.observed_monotonic_ns ? 0 : SHIRI_SOURCE_FAILURE;
+  return COMMAND_END;
+}
+
+int
+player_shiri_speech_status(struct player_shiri_speech_status *status)
+{
+  if (!status) return SHIRI_SOURCE_INVALID;
+  memset(status, 0, sizeof(*status));
+  return commands_exec_sync(cmdbase, shiri_speech_status_get, NULL, status);
+}
