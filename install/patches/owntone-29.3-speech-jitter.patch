+static json_object *
+shiri_speech_status_hex(const uint8_t id[16])
+{
+  static const char hex[] = "0123456789abcdef";
+  char text[33]; unsigned i;
+  for (i = 0; i < 16; ++i) { text[2*i] = hex[id[i] >> 4]; text[2*i+1] = hex[id[i] & 15]; }
+  text[32] = 0;
+  return json_object_new_string(text);
+}
+
+static json_object *
+shiri_speech_status_integer(uint64_t value)
+{
+  return json_object_new_int64(value > INT64_MAX ? INT64_MAX : (int64_t)value);
+}
+
