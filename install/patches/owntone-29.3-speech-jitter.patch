+/* A read-only player-thread snapshot. Querying diagnostics must not expire,
+ * prime, drain or otherwise alter admitted media or gain state. Counters are
+ * room-launch lifetime totals; current source binding is supplied by player. */
+void
+shiri_speech_status(struct shiri_speech_status *out)
+{
+  if (!out) return;
+  memset(out, 0, sizeof(*out));
+  out->observed_monotonic_ns = speech_now();
+  out->configured = speech_fd >= 0;
+  memcpy(out->room, speech.room, 16); memcpy(out->launch, speech.launch, 16);
+  out->sequence = speech.sequence; out->queue_frames = speech.count;
+  out->active = speech.active; out->running = speech.running;
+  out->priming = speech.running && speech.priming_until && out->observed_monotonic_ns && out->observed_monotonic_ns < speech.priming_until;
+#define COPY(field) out->field = speech.field
+  COPY(refused); COPY(expired); COPY(admitted); COPY(pcm_packets); COPY(admitted_frames); COPY(mixed_frames);
+  COPY(priming_events); COPY(priming_frames); COPY(empty_frames); COPY(underflow_events); COPY(underflow_frames);
+  COPY(priming_until); COPY(first_admission_ns); COPY(last_admission_ns); COPY(last_emitted_ns); COPY(last_mix_ns);
+  COPY(last_underflow_ns); COPY(last_resume_ns); COPY(max_admission_age_ns); COPY(max_interarrival_ns);
+#undef COPY
 }
 
