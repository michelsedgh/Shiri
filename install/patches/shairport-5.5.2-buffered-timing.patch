diff --git a/common.h b/common.h
index 11a10fc..bae24b2 100644
--- a/common.h
+++ b/common.h
@@ -326,6 +326,10 @@ typedef struct {
 
   double audio_backend_latency_offset; // this will be the offset in seconds to compensate for any
                                        // fixed latency there might be in the audio path
+#ifdef CONFIG_SHIRI
+  // Read once by the private backend. Never rewritten by per-stream latency guards.
+  int shiri_buffered_audio_advance_ms;
+#endif
   int audio_backend_silent_lead_in_time_auto; // true if the lead-in time should be from as soon as
                                               // packets are received
   double audio_backend_silent_lead_in_time; // the length of the silence that should precede a play.
diff --git a/rtp.c b/rtp.c
index ec71896..afc30d7 100644
--- a/rtp.c
+++ b/rtp.c
@@ -1492,6 +1492,15 @@ int get_ptp_anchor_local_time_info(rtsp_conn_info *conn, uint32_t *anchorRTP,
         // Use the current rate in case the stream format has changed.
         int32_t added_latency = (int32_t)(config.audio_backend_latency_offset * conn->input_rate);
         *anchorRTP = conn->last_anchor_rtptime - added_latency;
+#ifdef CONFIG_SHIRI
+        // Advance buffered AP2 within the bounded private handoff budget.
+        // Advance only this backend mapping; retain the source clock/anchor and
+        // leave realtime/AP1 latency negotiation and fallback behaviour unchanged.
+        if (config.output && strcmp(config.output->name, "shiri") == 0 &&
+            conn->airplay_type == ap_2 && conn->airplay_stream_type == buffered_stream)
+          *anchorRTP += (uint32_t)(((uint64_t)config.shiri_buffered_audio_advance_ms *
+                                    conn->input_rate) / 1000);
+#endif
       }
       if (anchorLocalTime != NULL)
         *anchorLocalTime = conn->last_anchor_local_time;
