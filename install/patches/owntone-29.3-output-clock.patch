diff --git a/src/outputs/airplay.c b/src/outputs/airplay.c
--- a/src/outputs/airplay.c
+++ b/src/outputs/airplay.c
@@ -4053,6 +4053,34 @@
   * Libratone Loop
      ["srcvers=190.9" "seed=99" "model=LibratoneLoop1" "flags=0x4" "features=0x444C0A00" "deviceid=XX:XX:XX:XX:XX:XX"]
  */
+/* An explicit ID selector overrides only legacy name-based timing choices.
+ * Auto retains native feature detection and daemon availability behavior. */
+static int
+airplay_shiri_timing_select(uint64_t id, cfg_t *devcfg, struct keyval *features)
+{
+  cfg_t *timing;
+  const char *protocol;
+  char selector[21];
+  bool supports_ptp;
+
+  snprintf(selector, sizeof(selector), "%" PRIu64, id);
+  timing = cfg_gettsec(cfg, "shiri_airplay_timing", selector);
+  supports_ptp = keyval_get(features, "SupportsPTP") != NULL;
+  if (!timing)
+    return supports_ptp && !(devcfg && cfg_getbool(devcfg, "ptp_disable")) && !airplay_ptp_is_disabled;
+
+  protocol = cfg_getstr(timing, "protocol");
+  if (protocol && strcmp(protocol, "ntp") == 0)
+    return 0;
+  if (protocol && strcmp(protocol, "ptp") == 0 && supports_ptp && !airplay_ptp_is_disabled)
+    return 1;
+
+  DPRINTF(E_LOG, L_AIRPLAY,
+          "AirPlay timing selector for ID %s cannot be applied: protocol=%s SupportsPTP=%d PTP service available=%d\n",
+          selector, protocol ? protocol : "missing", supports_ptp, !airplay_ptp_is_disabled);
+  return -1;
+}
