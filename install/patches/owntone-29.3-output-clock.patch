+/* Reject aliases and overflow before any device can consume a selector. */
+static int
+shiri_airplay_timing_validate(cfg_t *config)
+{
+  cfg_t *section;
+  const char *title, *protocol, *p;
+  uint64_t id;
+  unsigned int digit;
+  int i, j, count;
+
+  count = cfg_size(config, "shiri_airplay_timing");
+  for (i = 0; i < count; i++)
+    {
+      section = cfg_getnsec(config, "shiri_airplay_timing", i);
+      title = cfg_title(section);
+      protocol = cfg_getstr(section, "protocol");
+      if (!title || !*title || (title[0] == '0' && title[1] != '\0'))
+        goto invalid;
+      id = 0;
+      for (p = title; *p; p++)
+        {
+          if (*p < '0' || *p > '9')
+            goto invalid;
+          digit = (unsigned int)(*p - '0');
+          if (id > (UINT64_MAX - digit) / 10)
+            goto invalid;
+          id = id * 10 + digit;
+        }
+      if (!protocol || (strcmp(protocol, "ntp") != 0 && strcmp(protocol, "ptp") != 0))
+        goto invalid;
+      for (j = 0; j < i; j++)
+        if (strcmp(title, cfg_title(cfg_getnsec(config, "shiri_airplay_timing", j))) == 0)
+          goto invalid;
+    }
   return 0;
+
+ invalid:
+  DPRINTF(E_FATAL, L_CONF, "Invalid shiri_airplay_timing: require unique canonical uint64 ID and protocol ntp or ptp\n");
+  return -1;
 }
 
