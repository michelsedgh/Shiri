+       (shiri_warm_state.terminal && !memcmp(request->warm,shiri_warm_state.request.warm,16)))) return COMMAND_END;
+  if (request->action==SHIRI_WARM_RELEASE && shiri_warm_state.terminal) {
+    shiri_warm_reap();
