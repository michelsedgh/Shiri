+    param->reply.terminal=true; *retval=0; return COMMAND_END;
+  }
+  if (request->action!=SHIRI_WARM_ACQUIRE && !shiri_warm_matches(request)) return COMMAND_END;
+  if (request->action==SHIRI_WARM_ACQUIRE && !shiri_warm_matches(request) &&
