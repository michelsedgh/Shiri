--- /dev/null
+++ b/src/shiri_warm.h
@@ -0,0 +1,20 @@
+/* Private finite connection lease, independent of voice/media admission. */
+#ifndef SHIRI_WARM_H
+#define SHIRI_WARM_H
+#include "shiri_source.h"
+#define SHIRI_WARM_MAX_NS UINT64_C(300000000000)
+#define SHIRI_WARM_SETUP_NS UINT64_C(3000000000)
+#define SHIRI_WARM_OUTPUTS 128
+ enum shiri_warm_action { SHIRI_WARM_ACQUIRE, SHIRI_WARM_DEADLINE, SHIRI_WARM_OBSERVE, SHIRI_WARM_RELEASE };
+struct shiri_warm_request {
+  uint8_t room[16], launch[16], warm[16];
+  uint64_t generation, deadline_ns;
+  enum shiri_warm_action action;
+};
+struct shiri_warm_reply {
+  bool connected, pending, terminal;
+  uint64_t prepared_ns, expires_ns;
+  unsigned outputs;
+};
+int player_shiri_warm(const struct shiri_warm_request *, struct shiri_warm_reply *);
+#endif
diff --git a/src/shiri_warm_json.h b/src/shiri_warm_json.h
new file mode 100644
--- /dev/null
+++ b/src/shiri_warm_json.h
@@ -0,0 +1,30 @@
+#ifndef SHIRI_WARM_JSON_H
+#define SHIRI_WARM_JSON_H
+#include "shiri_warm.h"
+#include "shiri_source_json.h"
+static inline int
+shiri_warm_parse(json_object *body, struct shiri_warm_request *request)
+{
+  json_object *room, *launch, *warm, *generation, *deadline, *action;
+  const char *text;
+  if (!body || !json_object_is_type(body,json_type_object) || json_object_object_length(body)!=6 ||
+      !json_object_object_get_ex(body,"room_id",&room) || !json_object_object_get_ex(body,"launch_generation",&launch) ||
+      !json_object_object_get_ex(body,"warm_id",&warm) || !json_object_object_get_ex(body,"lease_generation",&generation) ||
+      !json_object_object_get_ex(body,"deadline_monotonic_ns",&deadline) || !json_object_object_get_ex(body,"action",&action)) return -1;
+  memset(request,0,sizeof(*request));
+  if (shiri_source_hex(room,request->room)<0 || shiri_zero(request->room,16) ||
+      shiri_source_hex(launch,request->launch)<0 || shiri_zero(request->launch,16) ||
+      shiri_source_hex(warm,request->warm)<0 || shiri_zero(request->warm,16) ||
+      shiri_source_integer(generation,&request->generation,true)<0 ||
+      shiri_source_integer(deadline,&request->deadline_ns,false)<0 || !json_object_is_type(action,json_type_string)) return -1;
+  text=json_object_get_string(action);
+  if ((size_t)json_object_get_string_len(action)!=strlen(text)) return -1;
+  if (!strcmp(text,"acquire")) request->action=SHIRI_WARM_ACQUIRE;
+  else if (!strcmp(text,"deadline")) request->action=SHIRI_WARM_DEADLINE;
+  else if (!strcmp(text,"observe")) request->action=SHIRI_WARM_OBSERVE;
+  else if (!strcmp(text,"release")) request->action=SHIRI_WARM_RELEASE;
+  else return -1;
+  return (request->action==SHIRI_WARM_ACQUIRE || request->action==SHIRI_WARM_DEADLINE)
+    ? (!request->deadline_ns ? -1 : 0) : (request->deadline_ns ? -1 : 0);
+}
+#endif
