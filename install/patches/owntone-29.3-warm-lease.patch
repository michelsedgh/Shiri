+      shiri_warm_event_clear(); memset(&shiri_warm_state,0,sizeof(shiri_warm_state));
+      shiri_warm_state.request=*request; shiri_warm_state.initialized=true; shiri_warm_state.active=true;
+      shiri_warm_state.began_ns=now;
+      if (shiri_warm_snapshot(true,false)<0) { shiri_warm_retire(true); *retval=SHIRI_SOURCE_FAILURE; return COMMAND_END; }
+      visited=0;
+      for (device=outputs_list();device && ++visited<=1024;device=device->next) {
+        if (!device->selected) continue;
+        for (index=0;index<shiri_warm_state.count;++index)
+          if (shiri_warm_state.outputs[index].id==device->id) break;
+        struct shiri_warm_output *out=&shiri_warm_state.outputs[index];
+        if (device->session) {
+          if ((device->state!=OUTPUT_STATE_CONNECTED && device->state!=OUTPUT_STATE_STREAMING) ||
+              outputs_shiri_warm_hold(device,device->session,device->shiri_session_serial,request->deadline_ns)<0) shiri_warm_state.failed=true;
+          continue;
+        }
+        out->awaiting=true; ++shiri_warm_state.pending;
+        ret=outputs_device_start(device,device_shiri_warm_start_cb,false);
+        out->session=device->session; out->session_serial=device->shiri_session_serial;
+        if (ret<=0 && out->awaiting) { out->awaiting=false; --shiri_warm_state.pending; }
+        if (ret<0 || !out->session) shiri_warm_state.failed=true;
+      }
+      if (visited>1024) shiri_warm_state.failed=true;
+    } else shiri_warm_state.request.deadline_ns=request->deadline_ns;
+  } else if (request->action==SHIRI_WARM_DEADLINE) {
+    if (!shiri_warm_state.active || shiri_warm_state.terminal) return COMMAND_END;
+    shiri_warm_state.request.deadline_ns=request->deadline_ns;
+  }
+  if (shiri_warm_state.active) {
+    if (!now || now>=shiri_warm_state.request.deadline_ns || shiri_warm_state.failed ||
+        (!shiri_warm_state.pending && shiri_warm_snapshot(false,true)<0)) shiri_warm_retire(true);
+    else {
+      if (!shiri_warm_state.pending && !shiri_warm_state.connected) {
+        shiri_warm_state.connected=true; shiri_warm_state.prepared_ns=now;
+      }
+      visited=0;
+      for (device=outputs_list();device && ++visited<=1024;device=device->next)
+        for (index=0;index<shiri_warm_state.count;++index)
+          if (device->id==shiri_warm_state.outputs[index].id && device->session==shiri_warm_state.outputs[index].session &&
+              device->shiri_session_serial==shiri_warm_state.outputs[index].session_serial &&
+              (device->state==OUTPUT_STATE_CONNECTED || device->state==OUTPUT_STATE_STREAMING))
+            outputs_shiri_warm_hold(device,device->session,device->shiri_session_serial,shiri_warm_state.request.deadline_ns);
+      if (shiri_warm_timer_arm(now)<0) shiri_warm_retire(true);
+    }
+  }
+  param->reply.connected=shiri_warm_state.active && shiri_warm_state.connected;
+  param->reply.pending=shiri_warm_pending_observed(); param->reply.terminal=shiri_warm_state.terminal;
+  param->reply.prepared_ns=shiri_warm_state.prepared_ns;
+  param->reply.expires_ns=shiri_warm_state.request.deadline_ns; param->reply.outputs=shiri_warm_state.count;
+  *retval=0; return COMMAND_END;
+}
+
+int
+player_shiri_warm(const struct shiri_warm_request *request,struct shiri_warm_reply *reply)
+{
+  struct shiri_warm_param param; int ret;
+  if (!request || !reply) return SHIRI_SOURCE_INVALID;
+  memset(&param,0,sizeof(param)); param.request=*request;
+  ret=commands_exec_sync(cmdbase,shiri_warm_command,NULL,&param);
+  if (!ret) *reply=param.reply;
+  return ret;
+}
