+/* Connection-only preparation: separate identity/counter from music and voice. */
+struct shiri_warm_output {
+  uint64_t id, session_serial; int type, offset_ms; void *session;
+  bool awaiting, created;
+};
+static struct {
+  struct shiri_warm_request request;
+  struct shiri_warm_output outputs[SHIRI_WARM_OUTPUTS];
+  unsigned count, pending;
+  uint64_t began_ns, prepared_ns;
+  bool initialized, active, connected, terminal, failed;
+} shiri_warm_state;
+static struct event *shiri_warm_event;
+static uint64_t shiri_warm_retired_generation;
+static struct shiri_warm_request shiri_warm_retired_request;
+struct shiri_warm_param { struct shiri_warm_request request; struct shiri_warm_reply reply; };
