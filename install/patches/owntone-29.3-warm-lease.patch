+    param->reply.prepared_ns=shiri_warm_state.prepared_ns;
+    param->reply.expires_ns=shiri_warm_state.request.deadline_ns; param->reply.outputs=shiri_warm_state.count;
+    *retval=0; return COMMAND_END;
+  }
+  if ((request->action==SHIRI_WARM_ACQUIRE || request->action==SHIRI_WARM_DEADLINE) &&
+      shiri_warm_matches(request) && shiri_warm_state.active && now>=shiri_warm_state.request.deadline_ns) {
+    /* Deadline ordering fences expiry even before its queued timer dispatch. */
+    shiri_warm_retire(false); return COMMAND_END;
+  }
+  shiri_warm_reap();
+  if (request->action==SHIRI_WARM_RELEASE) {
+    if (request->generation>shiri_warm_retired_generation) {
+      shiri_warm_retired_generation=request->generation; shiri_warm_retired_request=*request;
+    }
+    shiri_warm_retire(false);
+  }
+  else if (request->action==SHIRI_WARM_ACQUIRE) {
+    if (!shiri_source_state.initialized || shiri_source_state.faulted || shiri_source_wait.active || shiri_speech_start.pending)
+      return COMMAND_END;
+    if (shiri_warm_state.initialized &&
+        (request->generation<shiri_warm_state.request.generation ||
