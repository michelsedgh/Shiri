+         (shiri_warm_state.terminal && !memcmp(request->warm,shiri_warm_state.request.warm,16)))) return COMMAND_END;
+    if (!shiri_warm_matches(request)) {
+      if (shiri_warm_state.pending) return COMMAND_END;
+      /* Replacing a connected aggregate transfers existing sessions; no stop. */
+      for (device=outputs_list();device && ++visited<=1024;device=device->next)
+        for (index=0;index<shiri_warm_state.count;++index)
