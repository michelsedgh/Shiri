+static void device_shiri_warm_stop_cb(struct output_device *,enum output_device_state);
+
+static void
+shiri_warm_event_clear(void)
+{
+  if (shiri_warm_event) { event_free(shiri_warm_event); shiri_warm_event=NULL; }
 }
 
 static bool
+shiri_warm_matches(const struct shiri_warm_request *request)
+{
+  return shiri_warm_state.initialized && request &&
+    request->generation==shiri_warm_state.request.generation &&
+    !memcmp(request->warm,shiri_warm_state.request.warm,16) &&
+    !memcmp(request->room,shiri_warm_state.request.room,16) &&
+    !memcmp(request->launch,shiri_warm_state.request.launch,16);
+}
+
+static int
+shiri_warm_snapshot(bool capture,bool connected)
+{
+  struct output_device *device; unsigned count=0,visited=0,index;
+  for (device=outputs_list();device;device=device->next) {
+    if (++visited>1024) return -1;
+    if (!device->selected) continue;
+    if (count==SHIRI_WARM_OUTPUTS || device->busy || device->prevent_playback) return -1;
+    if (capture) {
+      shiri_warm_state.outputs[count].id=device->id;
+      shiri_warm_state.outputs[count].type=device->type;
+      shiri_warm_state.outputs[count].offset_ms=device->offset_ms;
+      shiri_warm_state.outputs[count].session=device->session;
+      shiri_warm_state.outputs[count].session_serial=device->shiri_session_serial;
+      shiri_warm_state.outputs[count].created=!device->session;
+    } else {
+      for (index=0;index<shiri_warm_state.count;++index)
+        if (shiri_warm_state.outputs[index].id==device->id) break;
+      if (index==shiri_warm_state.count || shiri_warm_state.outputs[index].type!=(int)device->type ||
+          shiri_warm_state.outputs[index].offset_ms!=device->offset_ms ||
+          shiri_warm_state.outputs[index].session!=device->session ||
+          shiri_warm_state.outputs[index].session_serial!=device->shiri_session_serial) return -1;
+    }
+    if (connected && (!device->session || (device->state!=OUTPUT_STATE_CONNECTED && device->state!=OUTPUT_STATE_STREAMING))) return -1;
+    ++count;
+  }
+  if (!count || (!capture && count!=shiri_warm_state.count)) return -1;
+  if (capture) shiri_warm_state.count=count;
+  return 0;
+}
+
+static bool
+shiri_warm_idle_cleanup_allowed(void)
+{
+  struct shiri_speech_status media;
+  if (!shiri_source_state.initialized || shiri_source_state.faulted || shiri_source_wait.active ||
+      !shiri_zero(shiri_source_state.last.owner.session,16) || player_state==PLAY_PLAYING ||
+      shiri_speech_start.pending || shiri_speech_bed_wanted()) return false;
+  shiri_speech_status(&media);
+  return !media.active && !media.running && !media.queue_frames;
+}
+
+static void
+shiri_warm_retire(bool failed)
+{
+  struct output_device *device; unsigned index,visited=0;
+  bool awaiting[SHIRI_WARM_OUTPUTS],cleanup=shiri_warm_idle_cleanup_allowed();
+  for (index=0;index<shiri_warm_state.count;++index) {
+    awaiting[index]=shiri_warm_state.outputs[index].awaiting;
+    shiri_warm_state.outputs[index].awaiting=false;
+  }
+  shiri_warm_state.pending=0;
+  shiri_warm_state.active=false; shiri_warm_state.connected=false; shiri_warm_state.terminal=true;
+  shiri_warm_state.failed=shiri_warm_state.failed || failed;
+  shiri_warm_event_clear();
+  for (device=outputs_list();device && ++visited<=1024;device=device->next)
+    for (index=0;index<shiri_warm_state.count;++index) {
+      struct shiri_warm_output *out=&shiri_warm_state.outputs[index];
+      if (device->id!=out->id || (int)device->type!=out->type || device->offset_ms!=out->offset_ms ||
+          !device->session || device->session!=out->session || device->shiri_session_serial!=out->session_serial) continue;
+      outputs_shiri_warm_release(device,out->session,out->session_serial);
+      if (awaiting[index] && outputs_shiri_callback_pending(device->id,device_shiri_warm_start_cb)) {
+        if (cleanup && out->created) {
+          /* Retire this START token before its later replies can mutate state. */
+          out->awaiting=true; ++shiri_warm_state.pending;
+          if (outputs_device_stop(device,device_shiri_warm_stop_cb)<=0 && out->awaiting) {
+            out->awaiting=false; --shiri_warm_state.pending;
+          }
+        } else outputs_device_cb_set(device,device_streaming_cb);
+      } else if (cleanup && device->selected)
+        outputs_device_stop_delayed(device,device_streaming_cb);
+    }
+}
+
+static void
+shiri_warm_timeout(int fd,short what,void *arg)
+{
+  (void)fd; (void)what;
+  if (!shiri_warm_state.initialized || (uint64_t)(uintptr_t)arg!=shiri_warm_state.request.generation ||
+      !shiri_warm_state.active) return;
+  shiri_warm_retire(!shiri_warm_state.connected);
+}
+
+static int
+shiri_warm_timer_arm(uint64_t now)
+{
+  uint64_t until=shiri_warm_state.request.deadline_ns;
+  struct timeval delay;
+  if (!shiri_warm_state.connected && until>shiri_warm_state.began_ns+SHIRI_WARM_SETUP_NS)
+    until=shiri_warm_state.began_ns+SHIRI_WARM_SETUP_NS;
+  if (!now || now>=until) return -1;
+  delay.tv_sec=(time_t)((until-now)/UINT64_C(1000000000));
+  delay.tv_usec=(suseconds_t)(((until-now)%UINT64_C(1000000000)+999)/1000);
+  if (delay.tv_usec>=1000000) { ++delay.tv_sec; delay.tv_usec-=1000000; }
+  shiri_warm_event_clear();
+  shiri_warm_event=evtimer_new(evbase_player,shiri_warm_timeout,(void *)(uintptr_t)shiri_warm_state.request.generation);
+  return !shiri_warm_event || evtimer_add(shiri_warm_event,&delay)<0 ? -1 : 0;
+}
+
+static void
+device_shiri_warm_stop_cb(struct output_device *device,enum output_device_state status)
+{
+  unsigned index; (void)status;
+  if (!shiri_warm_state.initialized || !shiri_warm_state.terminal || !shiri_warm_state.pending) return;
+  if (!device) { --shiri_warm_state.pending; return; }
+  for (index=0;index<shiri_warm_state.count;++index)
+    if (shiri_warm_state.outputs[index].id==device->id && shiri_warm_state.outputs[index].awaiting) {
+      shiri_warm_state.outputs[index].awaiting=false; --shiri_warm_state.pending; return;
+    }
+}
+
+static void
+device_shiri_warm_start_cb(struct output_device *device,enum output_device_state status)
+{
+  unsigned index; uint64_t now=shiri_speech_ready_now();
+  if (!shiri_warm_state.initialized || !shiri_warm_state.active || !shiri_warm_state.pending) return;
+  if (!device) { --shiri_warm_state.pending; shiri_warm_state.failed=true; return; }
+  for (index=0;index<shiri_warm_state.count;++index)
+    if (shiri_warm_state.outputs[index].id==device->id && shiri_warm_state.outputs[index].awaiting) break;
+  if (index==shiri_warm_state.count) return;
+  struct shiri_warm_output *out=&shiri_warm_state.outputs[index];
+  out->awaiting=false; --shiri_warm_state.pending;
+  if (!device->selected || !device->session || (out->session && (out->session!=device->session || out->session_serial!=device->shiri_session_serial)) || out->type!=(int)device->type ||
+      out->offset_ms!=device->offset_ms || (status!=OUTPUT_STATE_CONNECTED && status!=OUTPUT_STATE_STREAMING) ||
+      !now || now>=shiri_warm_state.request.deadline_ns || now<shiri_warm_state.began_ns ||
+      now-shiri_warm_state.began_ns>=SHIRI_WARM_SETUP_NS)
+    shiri_warm_state.failed=true;
+  else {
+    out->session=device->session; out->session_serial=device->shiri_session_serial;
+    /* Later music/voice callbacks replace this ordinary idle handler normally. */
+    outputs_device_cb_set(device,device_streaming_cb);
+    if (outputs_shiri_warm_hold(device,device->session,device->shiri_session_serial,shiri_warm_state.request.deadline_ns)<0)
+      shiri_warm_state.failed=true;
+  }
+  if (!shiri_warm_state.pending && !shiri_warm_state.failed && shiri_warm_snapshot(false,true)==0) {
+    shiri_warm_state.connected=true; shiri_warm_state.prepared_ns=now;
+    if (shiri_warm_timer_arm(now)<0) shiri_warm_retire(true);
+  }
+}
+
+static void
+shiri_warm_reap(void)
+{
+  unsigned index;
+  for (index=0;index<shiri_warm_state.count;++index)
+    if (shiri_warm_state.outputs[index].awaiting &&
+        !outputs_shiri_callback_pending(shiri_warm_state.outputs[index].id,
+          shiri_warm_state.terminal ? device_shiri_warm_stop_cb : device_shiri_warm_start_cb)) {
+      shiri_warm_state.outputs[index].awaiting=false;
+      if (shiri_warm_state.pending) --shiri_warm_state.pending;
+      shiri_warm_state.failed=true;
+    }
+}
+
+static bool
+shiri_warm_pending_observed(void)
+{
+  unsigned index;
+  for (index=0;index<shiri_warm_state.count;++index)
+    if (shiri_warm_state.outputs[index].awaiting &&
+        outputs_shiri_callback_pending(shiri_warm_state.outputs[index].id,
+          shiri_warm_state.terminal ? device_shiri_warm_stop_cb : device_shiri_warm_start_cb)) return true;
+  return false;
+}
+
+static enum command_state
+shiri_warm_command(void *arg,int *retval)
+{
+  struct shiri_warm_param *param=arg; const struct shiri_warm_request *request=&param->request;
+  struct output_device *device; uint64_t now=shiri_speech_ready_now(); unsigned visited=0,index; int ret;
+  *retval=SHIRI_SOURCE_INVALID;
+  if (!request->generation || request->generation>INT64_MAX || shiri_zero(request->warm,16) ||
+      !shiri_speech_ids_match(request->room,request->launch) || request->action<SHIRI_WARM_ACQUIRE || request->action>SHIRI_WARM_RELEASE)
+    return COMMAND_END;
+  if (request->action==SHIRI_WARM_ACQUIRE || request->action==SHIRI_WARM_DEADLINE) {
+    if (!now || request->deadline_ns<=now || request->deadline_ns>INT64_MAX || request->deadline_ns-now>SHIRI_WARM_MAX_NS) return COMMAND_END;
+  } else if (request->deadline_ns) return COMMAND_END;
+  *retval=SHIRI_SOURCE_CONFLICT;
+  if (request->action==SHIRI_WARM_OBSERVE) {
+    if (!shiri_warm_matches(request)) return COMMAND_END;
+    /* Pure bounded observation: no timer/hold/lease/callback/media mutation. */
+    param->reply.connected=shiri_warm_state.active && shiri_warm_state.connected && now &&
