+/* Transfer only acknowledged frames. A positive ALSA short write, EINTR or
+ * EAGAIN must not consume the raw tail that a later callback still owns.
+ * Bound work per callback; the existing OwnTone output timer supplies retries. */
+static int
+buffer_transfer(struct alsa_playback_session *pb, snd_pcm_sframes_t *avail)
+{
+  uint8_t *buf, *consumed;
+  ssize_t bytes, submitted;
+  snd_pcm_sframes_t nsamp, ret;
+  unsigned attempts = 0;
+
+  while (*avail > 0 && pb->prebuf.read_avail && attempts++ < 8)
+    {
+      bytes = snd_pcm_frames_to_bytes(pb->pcm, *avail);
+      if (bytes <= 0)
+        return -EINVAL;
+      if ((size_t)bytes > pb->prebuf.read_avail)
+        bytes = pb->prebuf.read_avail;
+      if ((size_t)bytes > pb->prebuf.size - pb->prebuf.read_pos)
+        bytes = pb->prebuf.size - pb->prebuf.read_pos;
+      nsamp = snd_pcm_bytes_to_frames(pb->pcm, bytes);
+      if (nsamp <= 0 || nsamp > *avail || snd_pcm_frames_to_bytes(pb->pcm, nsamp) != bytes)
+        return -EINVAL;
+      buf = pb->prebuf.buffer + pb->prebuf.read_pos;
+      ret = pcm_write(pb, buf, nsamp);
+      if (ret == 0 || ret == -EAGAIN || ret == -EINTR)
+        return 0;
+      if (ret < 0)
+        return ret;
+      if (ret > nsamp)
+        return -EIO;
+      submitted = snd_pcm_frames_to_bytes(pb->pcm, ret);
+      if (submitted <= 0 || submitted > bytes)
+        return -EINVAL;
+      if (ringbuffer_read(&consumed, submitted, &pb->prebuf) != (size_t)submitted || consumed != buf)
+        return -EIO;
+      *avail -= ret;
+    }
+  return 0;
+}
