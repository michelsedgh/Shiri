+/* The prebuffer is the bounded per-playback raw queue. Never silently accept a
+ * partially appended source block when a device stops making enough progress. */
+static int
+buffer_append(struct alsa_playback_session *pb, const uint8_t *buf, size_t bytes)
+{
+  if (bytes > pb->prebuf.write_avail)
+    {
+      DPRINTF(E_LOG, L_LAUDIO, "ALSA raw queue has insufficient capacity; refusing to discard audio\n");
+      return -ENOBUFS;
+    }
+  if (bytes && ringbuffer_write(&pb->prebuf, buf, bytes) != bytes)
+    return -EIO;
+  return 0;
+}
