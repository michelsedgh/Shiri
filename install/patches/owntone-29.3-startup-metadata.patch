+/* The Shiri framed stream has no DB queue item while idle. Some AirPlay
+ * receivers, including Sonos, require initial DMAP metadata before unmuting.
+ * Keep this request in START_PLAYBACK, ahead of the final volume request, so
+ * CONNECTED cannot acknowledge startup until the receiver accepted it. This
+ * bounded placeholder never becomes global music metadata or computes a
+ * progress clock from the not-yet-initialized cur_stamp. */
+static int
+payload_make_shiri_startup_metadata(struct evrtsp_request *req, struct airplay_session *session, void *arg)
+{
+  const char *speech_socket;
+  char rtpinfo[32];
+  size_t before;
+  int ret;
+  (void)arg;
+  speech_socket = cfg_getstr(cfg_getsec(cfg, "general"), "shiri_speech_socket");
+  if (!speech_socket || !*speech_socket ||
+      !cfg_getbool(cfg_getsec(cfg, "library"), "pipe_framed") ||
+      !(session->wanted_metadata & AIRPLAY_MD_WANTS_TEXT) || airplay_cur_metadata)
+    return 1; /* Skip to the final volume step; ordinary music is unchanged. */
+  if (!session->master_session || !session->master_session->rtp_session)
+    return -1;
+  ret = snprintf(rtpinfo, sizeof(rtpinfo), "rtptime=%" PRIu32, session->master_session->rtp_session->pos);
+  if (ret < 0 || (size_t)ret >= sizeof(rtpinfo)) return -1;
+  if (evrtsp_add_header(req->output_headers, "RTP-Info", rtpinfo) < 0) return -1;
+  before = evbuffer_get_length(req->output_buffer);
+  dmap_add_container(req->output_buffer, "mlit", 63);
+  dmap_add_char(req->output_buffer, "mikd", 2);
+  dmap_add_string(req->output_buffer, "minm", "Shiri");
+  dmap_add_string(req->output_buffer, "asar", "Shiri");
+  dmap_add_string(req->output_buffer, "asal", "Room audio");
+  dmap_add_short(req->output_buffer, "astn", 1);
+  if (evbuffer_get_length(req->output_buffer) - before != 71) return -1;
+  session->shiri_startup_metadata_rtp = session->master_session->rtp_session->pos;
+  session->shiri_startup_metadata_acked = false;
+  return 0;
+}
