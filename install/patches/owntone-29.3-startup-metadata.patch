+/* START_PLAYBACK owns the callback incarnation; sequence_continue_cb checks
+ * it before invoking this handler. Log a durable receipt for passive diagnosis
+ * without claiming that the physical receiver has rendered any PCM. */
+static enum airplay_seq_type
+response_handler_shiri_startup_metadata(struct evrtsp_request *req, struct airplay_session *session)
+{
+  if (!req || req->response_code != RTSP_OK) return AIRPLAY_SEQ_ABORT;
+  session->shiri_startup_metadata_acked = true;
+  DPRINTF(E_LOG, L_AIRPLAY, "Shiri initial metadata acknowledged: device=%" PRIu64 ", callback=%d, rtptime=%" PRIu32 "\n",
+          session->device_id, session->callback_id, session->shiri_startup_metadata_rtp);
+  return AIRPLAY_SEQ_CONTINUE;
+}
