+static int
+speech_envelope_valid(uint32_t envelope)
+{
+  unsigned attack = envelope >> 16, release = envelope & 65535u;
+  /* A zero word retains the original per-unit 40/250ms envelope. An optional
+   * producer policy names complete current-gain-to-target durations in ms. */
+  return !envelope || (attack >= SPEECH_ENVELOPE_MIN_MS && attack <= SPEECH_ATTACK_MAX_MS &&
+                      release >= SPEECH_ENVELOPE_MIN_MS && release <= SPEECH_RELEASE_MAX_MS);
+}
+
+static void
+speech_gain_step(struct speech_state *s, double target)
+{
+  double step;
+  if (!s->envelope) {
+    step = 1.0 / (SPEECH_RATE * (target < s->gain ? 0.04 : 0.25));
+    if (target < s->gain) { s->gain -= step; if (s->gain < target) s->gain = target; }
+    else if (target > s->gain) { s->gain += step; if (s->gain > target) s->gain = target; }
+    return;
+  }
+  /* Retarget from the current sample gain, never from unity or the previous
+   * target. EOF/cancel/expiry keep this policy until restoration completes. */
+  if (s->ramp_target != target || (!s->ramp_frames && s->gain != target)) {
+    unsigned duration = target < s->gain ? s->envelope >> 16 : s->envelope & 65535u;
+    s->ramp_start = s->gain; s->ramp_target = target;
+    s->ramp_frames = s->gain == target ? 0 : duration * (SPEECH_RATE / 1000u);
+    s->ramp_remaining = s->ramp_frames;
+  }
+  if (s->ramp_remaining) {
+    --s->ramp_remaining;
+    s->gain = s->ramp_start + (target - s->ramp_start) *
+              (double)(s->ramp_frames - s->ramp_remaining) / s->ramp_frames;
+    if (!s->ramp_remaining) s->gain = target;
+  }
+}
+
+static void
+speech_fresh_music(struct speech_state *s)
+{
+  /* A completed idle utterance had no music to restore. Its suspended fade
+   * must not attenuate the first samples of a later unrelated music source.
+   * Admitted/queued voice still owns its gain through source transitions. */
+  if (s->accepting || s->active || s->running || s->count) return;
+  s->gain = s->ramp_start = s->ramp_target = 1.0;
+  s->ramp_frames = s->ramp_remaining = 0;
 }
 
