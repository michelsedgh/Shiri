+/* Output-only voice uses OwnTone's existing output clock. It never writes
+ * a framed phone/idle packet, reads input, marks a music anchor or changes P.
+ * A prepared source/selected-session snapshot is exact and bounded; admitted
+ * media retains its own existing lease/queue across music source transitions. */
+static bool
+shiri_speech_bed_wanted(void)
+{
+  struct shiri_speech_status media;
+  uint64_t now = shiri_speech_ready_now();
+  bool prepared;
+  if (!now || !shiri_source_state.initialized || shiri_source_state.faulted) return false;
+  shiri_speech_status(&media);
+  if (shiri_voice_initialized && (media.active || media.running || media.queue_frames)) return true;
+  prepared = shiri_speech_start.initialized && shiri_speech_start.connected && !shiri_speech_start.failed &&
+    shiri_speech_source_matches(&shiri_speech_start.request) &&
+    now >= shiri_speech_start.began_ns && now-shiri_speech_start.began_ns < SHIRI_SPEECH_SETUP_NS &&
+    shiri_speech_outputs_snapshot(false, true) == 0;
+  /* A terminal admitted voice must not leave its preparation bed alive. A
+   * fresh BEGIN still gets the finite setup grace until its first FIFO control. */
+  if (prepared && shiri_voice_initialized &&
+      !memcmp(shiri_voice_request.speech, shiri_speech_start.request.speech, 16) &&
+      shiri_voice_request.action != SHIRI_SPEECH_BEGIN) return false;
+  return prepared;
+}
+
+static void
+shiri_speech_bed_retire_outputs(void)
+{
+  struct output_device *device;
+  unsigned visited = 0;
+  /* The final voice tick may have canceled END's delayed release. Restore
+   * that finite cleanup only for the exact still-idle source and sessions
+   * which this bed actually mixed; never stop a paused phone or successor. */
+  if (!shiri_source_state.initialized || shiri_source_state.faulted || shiri_speech_bed_wanted() ||
+      !shiri_zero(shiri_source_state.last.owner.session, 16) || !shiri_last_mix.mixed_ns ||
+      shiri_last_mix.source.operation_generation != shiri_source_state.last.operation_generation ||
+      !shiri_source_owner_equal(&shiri_last_mix.source.owner, &shiri_source_state.last.owner) ||
+      shiri_speech_last_outputs(false) < 0) return;
+  for (device = outputs_list(); device && ++visited <= 1024; device = device->next)
+    if (device->selected) outputs_device_stop_delayed(device, device_streaming_cb);
+}
+
+static int
+shiri_speech_bed_arm(void)
+{
+  struct itimerspec tick;
+  struct output_device *device;
+  unsigned visited = 0;
+  int ret;
+  if (!shiri_speech_bed_wanted()) return 0;
+  if (shiri_speech_last_outputs(true) < 0) return -1;
+  for (device = outputs_list(); device && ++visited <= 1024; device = device->next)
+    if (device->selected)
+      {
+        if (outputs_shiri_stop_delayed_cancel(device) < 0) return -1;
+        outputs_device_cb_set(device, device_streaming_cb);
+      }
+  if (visited > 1024) return -1;
+  if (pb_timer_native || pb_timer_speech_only) return 0;
+  if (player_state == PLAY_PLAYING) return -1; /* never take a different program's clock */
+  if (event_add(pb_timer_ev, NULL) < 0) return -1;
+  tick.it_interval = player_tick_interval;
+  tick.it_value = player_tick_interval;
+#ifdef HAVE_TIMERFD
+  ret = timerfd_settime(pb_timer_fd, 0, &tick, NULL);
+#else
+  ret = timer_settime(pb_timer, 0, &tick, NULL);
+#endif
+  if (ret < 0) { event_del(pb_timer_ev); return -1; }
+  pb_timer_speech_only = true;
+  return 0;
+}
+
+static bool
+shiri_speech_bed_tick(void)
+{
+  struct timespec tick_end, fresh, anchor, start, duration;
+  struct media_quality quality = { .sample_rate = 48000, .bits_per_sample = 16, .channels = 2 };
+  uint8_t buffer[480 * 4] = { 0 };
+  uint64_t operation, elapsed;
+  int ret, frames;
+  if (!shiri_speech_bed_wanted() ||
+      (!pb_timer_speech_only && (!pb_timer_native || !pb_timer_native_waiting_for_pcm || pb_timer_native_anchored)) ||
+      player_tick_interval.tv_sec || player_tick_interval.tv_nsec != 10000000L ||
+      input_pipe_shiri_state(&operation) != 1 || operation != shiri_source_state.last.operation_generation ||
+      shiri_speech_last_outputs(true) < 0) return false;
+  /* Reserve no future output horizon. T is captured before the empty peek:
+   * this voice-only bed represents the preceding player interval and ends
+   * no later than T. Any music P accepted as genuinely future on its later
+   * fresh native-prepare clock is therefore strictly after this bed's O_end.
+   * A packet arriving just after peek with only1ms remaining lead remains
+   * playable at its original P; neither input locks nor a new lead/buffer,
+   * sample discard or source admission change is needed. Transport timing
+   * still adds the existing output buffer B to this output-only timestamp. */
+  if (clock_gettime(CLOCK_MONOTONIC, &tick_end) < 0) return false;
+  if (!tick_end.tv_sec && tick_end.tv_nsec < 10000000L) return true;
+  ret = input_peek_sync(&anchor);
+  if (ret != 0) return false; /* genuine queued PCM/anchor always wins */
+  if (clock_gettime(CLOCK_MONOTONIC, &fresh) < 0) return false;
+  duration.tv_sec = 0; duration.tv_nsec = 10000000L;
+  if (timespec_cmp(fresh, timespec_add(tick_end, duration)) > 0)
+    return true; /* mutex/scheduling stall: retry without a stale bed write */
+  start = tick_end;
+  if (start.tv_nsec < 10000000L) { --start.tv_sec; start.tv_nsec += 1000000000L; }
+  start.tv_nsec -= 10000000L;
+  if (shiri_output_end_valid)
+    {
+      if (timespec_cmp(shiri_output_end, tick_end) >= 0) return true;
+      elapsed = (uint64_t)(tick_end.tv_sec - shiri_output_end.tv_sec) * UINT64_C(1000000000);
+      elapsed += tick_end.tv_nsec;
+      elapsed -= shiri_output_end.tv_nsec;
+      /* Preserve O/sample continuity through normal timer jitter. Following
+       * a missed tick or an intentional gap, restart only this empty output
+       * bed in the preceding interval instead of accumulating stale voice. */
+      if (elapsed <= UINT64_C(20000000)) start = shiri_output_end;
+    }
+  elapsed = (uint64_t)(tick_end.tv_sec - start.tv_sec) * UINT64_C(1000000000);
+  elapsed += tick_end.tv_nsec;
+  elapsed -= start.tv_nsec;
+  frames = elapsed >= UINT64_C(10000000) ? 480 : (int)(elapsed * 48000 / UINT64_C(1000000000));
+  if (frames <= 0) return true;
+  shiri_speech_mix(buffer, frames * 4, frames, 48000, 16, 2);
+  outputs_write(buffer, frames * 4, frames, &quality, &start);
+  duration.tv_sec = 0; duration.tv_nsec = (long)(UINT64_C(1000000000) * frames / 48000);
+  shiri_output_end = timespec_add(start, duration);
+  shiri_output_end_valid = true;
+  shiri_output_bed_frames += frames;
+  shiri_speech_mix_ready(true);
+  return true;
+}
