diff --git a/shiri_pcm.h b/shiri_pcm.h
new file mode 100644
index 0000000000000000000000000000000000000000..97603edd62ca0e725cdb1fd2ffeca1dc62afceeb
--- /dev/null
+++ b/shiri_pcm.h
@@ -0,0 +1,78 @@
+/* Shiri PCM v1: bounded provenance framing, independent of output scheduling. */
+#ifndef SHIRI_PCM_H
+#define SHIRI_PCM_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <limits.h>
+
+#define SHIRI_PCM_HEADER 160u
+#define SHIRI_PCM_MAX_FRAMES 8192u
+#define SHIRI_PCM_RATE 48000u
+#define SHIRI_PCM_MAX_PAYLOAD (SHIRI_PCM_MAX_FRAMES * 4u)
+#define SHIRI_PCM_GAP 1u
+#define SHIRI_PCM_AIRPLAY2 2u
+#define SHIRI_PCM_GROUP_LEADER 4u
+#define SHIRI_PCM_SPEECH_ONLY 8u
+enum shiri_pcm_kind { SHIRI_BEGIN=1, SHIRI_PCM=2, SHIRI_FLUSH=3, SHIRI_END=4, SHIRI_VOLUME=5, SHIRI_GRANT=6 };
+enum shiri_pcm_clock { SHIRI_RAW=1, SHIRI_MONOTONIC=2 };
+struct shiri_pcm_owner {
+  uint8_t incarnation[16];
+  uint8_t session[16];
+  uint64_t epoch;
+  uint64_t generation;
+};
+struct shiri_pcm_packet {
+  uint8_t kind, clock;
+  uint32_t payload, frames, rtp, flags;
+  uint8_t session[16], incarnation[16], group[16];
+  uint64_t epoch, generation, sequence, frame_index, presentation;
+  uint64_t raw_sample, mono_before, mono_after;
+};
+static inline uint32_t shiri_u32(const uint8_t *p) {
+  return ((uint32_t)p[0]<<24)|((uint32_t)p[1]<<16)|((uint32_t)p[2]<<8)|p[3];
+}
+static inline uint64_t shiri_u64(const uint8_t *p) {
+  return ((uint64_t)shiri_u32(p)<<32)|shiri_u32(p+4);
+}
+static inline void shiri_put32(uint8_t *p, uint32_t n) {
+  p[0]=(uint8_t)(n>>24); p[1]=(uint8_t)(n>>16); p[2]=(uint8_t)(n>>8); p[3]=(uint8_t)n;
+}
+static inline void shiri_put64(uint8_t *p, uint64_t n) {
+  shiri_put32(p,(uint32_t)(n>>32)); shiri_put32(p+4,(uint32_t)n);
+}
+static inline int shiri_zero(const uint8_t *p, size_t n) {
+  size_t i; for(i=0;i<n;i++) if(p[i]) return 0; return 1;
+}
+/* 0 means valid header, -1 malformed. Payload is validated independently. */
+static inline int shiri_pcm_decode(struct shiri_pcm_packet *out, const uint8_t *p, size_t n) {
+  if(!out || !p || n<SHIRI_PCM_HEADER || memcmp(p,"SHRIPCM1",8) ||
+     p[8]<SHIRI_BEGIN || p[8]>SHIRI_GRANT || p[9]<SHIRI_RAW || p[9]>SHIRI_MONOTONIC ||
+     p[10] || p[11]!=1 || shiri_u32(p+12)!=SHIRI_PCM_HEADER || shiri_u32(p+20)!=SHIRI_PCM_RATE ||
+     !shiri_zero(p+148,12)) return -1;
+  memset(out,0,sizeof(*out));
+  out->kind=p[8]; out->clock=p[9]; out->payload=shiri_u32(p+16); out->frames=shiri_u32(p+24);
+  out->rtp=shiri_u32(p+28); out->flags=shiri_u32(p+32);
+  memcpy(out->session,p+36,16); memcpy(out->incarnation,p+52,16); memcpy(out->group,p+68,16);
+  out->epoch=shiri_u64(p+84); out->generation=shiri_u64(p+92); out->sequence=shiri_u64(p+100);
+  out->frame_index=shiri_u64(p+108); out->presentation=shiri_u64(p+116);
+  out->raw_sample=shiri_u64(p+124); out->mono_before=shiri_u64(p+132); out->mono_after=shiri_u64(p+140);
+  if(out->flags&~15u || !out->generation || out->generation>INT64_MAX || out->epoch>INT64_MAX ||
+     out->sequence>INT64_MAX || out->frame_index>INT64_MAX || out->presentation>INT64_MAX ||
+     out->raw_sample>INT64_MAX || out->mono_before>INT64_MAX || out->mono_after>INT64_MAX ||
+     (shiri_zero(out->session,16) && !(out->flags&SHIRI_PCM_SPEECH_ONLY))) return -1;
+  if(out->kind==SHIRI_PCM) {
+    if(!out->frames || out->frames>SHIRI_PCM_MAX_FRAMES || out->payload!=out->frames*4u || !out->presentation) return -1;
+  } else if(out->payload || out->frames>(out->kind==SHIRI_VOLUME?100u:0u)) return -1;
+  return 0;
+}
+static inline void shiri_pcm_encode(uint8_t p[SHIRI_PCM_HEADER], const struct shiri_pcm_packet *v) {
+  memset(p,0,SHIRI_PCM_HEADER); memcpy(p,"SHRIPCM1",8); p[8]=v->kind; p[9]=v->clock; p[11]=1;
+  shiri_put32(p+12,SHIRI_PCM_HEADER); shiri_put32(p+16,v->payload); shiri_put32(p+20,SHIRI_PCM_RATE);
+  shiri_put32(p+24,v->frames); shiri_put32(p+28,v->rtp); shiri_put32(p+32,v->flags);
+  memcpy(p+36,v->session,16); memcpy(p+52,v->incarnation,16); memcpy(p+68,v->group,16);
+  shiri_put64(p+84,v->epoch); shiri_put64(p+92,v->generation); shiri_put64(p+100,v->sequence);
+  shiri_put64(p+108,v->frame_index); shiri_put64(p+116,v->presentation); shiri_put64(p+124,v->raw_sample);
+  shiri_put64(p+132,v->mono_before); shiri_put64(p+140,v->mono_after);
+}
+#endif
diff --git a/shiri_timing.h b/shiri_timing.h
new file mode 100644
index 0000000000000000000000000000000000000000..ebb799df4ec9f3a12f8b053810ccfe094e358f9b
--- /dev/null
+++ b/shiri_timing.h
@@ -0,0 +1,12 @@
+/* First-sample timing after dropping actual post-conversion output frames. */
+#ifndef SHIRI_TIMING_H
+#define SHIRI_TIMING_H
+#include <stdint.h>
+#include <limits.h>
+static inline uint64_t shiri_skipped_time(uint64_t time, uint32_t skipped, uint32_t output_rate) {
+  uint64_t advance;
+  if (!output_rate) return time;
+  advance = (uint64_t)skipped * UINT64_C(1000000000) / output_rate;
+  return time > UINT64_MAX - advance ? UINT64_MAX : time + advance;
+}
+#endif
