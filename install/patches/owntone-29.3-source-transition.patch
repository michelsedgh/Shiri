+  pending = outputs_shiri_flush(device_shiri_flush_cb, &shiri_source_flush_failed);
+  outputs_metadata_purge();
+  *retval = pending > 0 ? pending : (shiri_source_flush_failed ? SHIRI_SOURCE_FAILURE : 0);
