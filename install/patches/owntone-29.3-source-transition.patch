diff --git a/src/shiri_source.h b/src/shiri_source.h
new file mode 100644
index 00000000..55eb9e07
--- /dev/null
+++ b/src/shiri_source.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Source transition admission, separate from speaker scheduling and speech. */
+#ifndef SHIRI_SOURCE_H
+#define SHIRI_SOURCE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <limits.h>
+#include "inputs/shiri_pcm.h"
+
+struct shiri_source_request {
+  struct shiri_pcm_owner owner;
+  uint64_t operation_generation;
+};
+
+struct shiri_source_state {
+  struct shiri_source_request last;
+  bool initialized;
+  bool faulted;
+};
+
+enum shiri_source_result {
+  SHIRI_SOURCE_NEW = 1,
+  SHIRI_SOURCE_REPLAY = 0,
+  SHIRI_SOURCE_FAILURE = -1,
+  SHIRI_SOURCE_CONFLICT = -2,
+  SHIRI_SOURCE_INVALID = -3,
+  SHIRI_SOURCE_FAULTED = -4
+};
+
+static inline bool
+shiri_source_owner_equal(const struct shiri_pcm_owner *a, const struct shiri_pcm_owner *b)
+{
+  return !memcmp(a->incarnation, b->incarnation, 16)
+    && !memcmp(a->session, b->session, 16)
+    && a->epoch == b->epoch && a->generation == b->generation;
+}
+
+/* Check before sealing or flushing anything. No invalid/stale request has effects. */
+static inline int
+shiri_source_check(const struct shiri_source_state *state, const struct shiri_source_request *request)
+{
+  const struct shiri_pcm_owner *old, *next;
+  bool old_idle, next_idle;
+
+  if (!state || !request)
+    return SHIRI_SOURCE_INVALID;
+  next = &request->owner;
+  if (!request->operation_generation || request->operation_generation > INT64_MAX
+      || !next->generation || next->generation > INT64_MAX || next->epoch > INT64_MAX
+      || shiri_zero(next->incarnation, 16))
+    return SHIRI_SOURCE_INVALID;
+
+  next_idle = shiri_zero(next->session, 16);
+  if (!state->initialized)
+    return next_idle && next->epoch == 0 && next->generation == 1
+      && request->operation_generation == 1 ? SHIRI_SOURCE_NEW : SHIRI_SOURCE_CONFLICT;
+  old = &state->last.owner;
+  if (memcmp(old->incarnation, next->incarnation, 16))
+    return SHIRI_SOURCE_CONFLICT;
+  if (state->faulted)
+    return SHIRI_SOURCE_FAULTED;
+  if (request->operation_generation == state->last.operation_generation)
+    return shiri_source_owner_equal(old, next) ? SHIRI_SOURCE_REPLAY : SHIRI_SOURCE_CONFLICT;
+  if (state->last.operation_generation == INT64_MAX
+      || request->operation_generation != state->last.operation_generation + 1)
+    return SHIRI_SOURCE_CONFLICT;
+
+  old_idle = shiri_zero(old->session, 16);
+  if (next->epoch == old->epoch)
+    {
+      if (next_idle)
+        return !old_idle && next->generation == 1 ? SHIRI_SOURCE_NEW : SHIRI_SOURCE_CONFLICT;
+      return !old_idle && !memcmp(old->session, next->session, 16)
+        && old->generation < INT64_MAX && next->generation == old->generation + 1
+        ? SHIRI_SOURCE_NEW : SHIRI_SOURCE_CONFLICT;
+    }
+  return !next_idle && old->epoch < INT64_MAX && next->epoch == old->epoch + 1
+    && next->generation == 1 ? SHIRI_SOURCE_NEW : SHIRI_SOURCE_CONFLICT;
+}
+
+static inline void
+shiri_source_begin(struct shiri_source_state *state, const struct shiri_source_request *request)
+{
+  state->last = *request;
+  state->initialized = true;
+  state->faulted = true; /* Only the final confirmed arm clears this seal. */
+}
+
+#endif
diff --git a/src/shiri_source_json.h b/src/shiri_source_json.h
new file mode 100644
index 00000000..53f9733c
--- /dev/null
+++ b/src/shiri_source_json.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef SHIRI_SOURCE_JSON_H
+#define SHIRI_SOURCE_JSON_H
+#include <json-c/json.h>
+#include "shiri_source.h"
+
+static inline int
+shiri_source_hex(json_object *object, uint8_t out[16])
+{
+  const char *text;
+  int index, high, low;
+  if (!object || !json_object_is_type(object, json_type_string)
+      || json_object_get_string_len(object) != 32)
+    return -1;
+  text = json_object_get_string(object);
+  for (index = 0; index < 16; index++)
+    {
+      high = text[index * 2]; low = text[index * 2 + 1];
+      if (!((high >= '0' && high <= '9') || (high >= 'a' && high <= 'f'))
+          || !((low >= '0' && low <= '9') || (low >= 'a' && low <= 'f')))
+        return -1;
+      high = high <= '9' ? high - '0' : high - 'a' + 10;
+      low = low <= '9' ? low - '0' : low - 'a' + 10;
+      out[index] = (uint8_t)((high << 4) | low);
+    }
+  return 0;
+}
+
+static inline int
+shiri_source_integer(json_object *object, uint64_t *out, bool positive)
+{
+  if (!object || !json_object_is_type(object, json_type_int)
+      || json_object_get_int64(object) < 0 || json_object_get_uint64(object) > INT64_MAX)
+    return -1;
+  *out = json_object_get_uint64(object);
+  return positive && !*out ? -1 : 0;
+}
+
+static inline int
+shiri_source_parse_field(json_object *body, struct shiri_source_request *request, const char *field, bool positive)
+{
+  json_object *incarnation, *session, *epoch, *generation, *operation;
+  if (!body || !json_object_is_type(body, json_type_object)
+      || json_object_object_length(body) != 5
+      || !json_object_object_get_ex(body, "incarnation", &incarnation)
+      || !json_object_object_get_ex(body, "session_id", &session)
+      || !json_object_object_get_ex(body, "epoch", &epoch)
+      || !json_object_object_get_ex(body, "generation", &generation)
+      || !json_object_object_get_ex(body, field, &operation))
+    return -1;
+  memset(request, 0, sizeof(*request));
+  if (shiri_source_hex(incarnation, request->owner.incarnation) < 0
+      || (session && shiri_source_hex(session, request->owner.session) < 0)
+      || shiri_source_integer(epoch, &request->owner.epoch, false) < 0
+      || shiri_source_integer(generation, &request->owner.generation, true) < 0
+      || shiri_source_integer(operation, &request->operation_generation, positive) < 0)
+    return -1;
+  /* Zero is the wire's idle identity and must be spelled null, not a UUID. */
+  if (shiri_zero(request->owner.incarnation, 16)
+      || (session && shiri_zero(request->owner.session, 16)))
+    return -1;
+  return 0;
+}
+static inline int
+shiri_source_parse(json_object *body, struct shiri_source_request *request)
+{
+  return shiri_source_parse_field(body, request, "operation_generation", true);
+}
+
+static inline int
+shiri_source_volume_parse(json_object *body, struct shiri_source_request *request)
+{
+  return shiri_source_parse_field(body, request, "volume", false) < 0
+    || request->operation_generation > 100 || shiri_zero(request->owner.session, 16) ? -1 : 0;
+}
+#endif
