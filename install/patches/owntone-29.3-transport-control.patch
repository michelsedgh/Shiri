diff --git a/src/outputs/cast_json.h b/src/outputs/cast_json.h
new file mode 100644
index 00000000..b6b5f586
--- /dev/null
+++ b/src/outputs/cast_json.h
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef SHIRI_CAST_JSON_H
+#define SHIRI_CAST_JSON_H
+#include <json.h>
+#include <stddef.h>
+#include <string.h>
+
+/* json-c overwrites duplicate keys. Control acknowledgments must have one
+ * unambiguous interpretation, including status/applications/sessionId. */
+static void
+cast_json_space(const char **cursor)
+{
+  while (**cursor == ' ' || **cursor == '\t' || **cursor == '\r' || **cursor == '\n')
+    (*cursor)++;
+}
+
+static const char *
+cast_json_string_end(const char *cursor)
+{
+  if (*cursor++ != '"')
+    return NULL;
+  while (*cursor)
+    {
+      if (*cursor == '"')
+        return cursor + 1;
+      if (*cursor++ == '\\')
+        { if (!*cursor) return NULL; cursor++; }
+    }
+  return NULL;
+}
+
+static int
+cast_json_number(const char *cursor, const char *end)
+{
+  if (cursor < end && *cursor == '-') cursor++;
+  if (cursor == end) return -1;
+  if (*cursor == '0') cursor++;
+  else
+    {
+      if (*cursor < '1' || *cursor > '9') return -1;
+      do { cursor++; } while (cursor < end && *cursor >= '0' && *cursor <= '9');
+    }
+  if (cursor < end && *cursor == '.')
+    {
+      cursor++;
+      if (cursor == end || *cursor < '0' || *cursor > '9') return -1;
+      do { cursor++; } while (cursor < end && *cursor >= '0' && *cursor <= '9');
+    }
+  if (cursor < end && (*cursor == 'e' || *cursor == 'E'))
+    {
+      cursor++;
+      if (cursor < end && (*cursor == '+' || *cursor == '-')) cursor++;
+      if (cursor == end || *cursor < '0' || *cursor > '9') return -1;
+      do { cursor++; } while (cursor < end && *cursor >= '0' && *cursor <= '9');
+    }
+  return cursor == end ? 0 : -1;
+}
+
+static int
+cast_json_unique(const char **cursor, unsigned int depth)
+{
+  json_object *seen, *key, *old;
+  struct json_tokener *tokener;
+  const char *end, *name;
+  unsigned int fields = 0;
+  size_t length;
+  char closing;
+  int ret = -1;
+  if (depth > 32)
+    return -1;
+  cast_json_space(cursor);
+  if (**cursor == '{')
+    {
+      (*cursor)++;
+      seen = json_object_new_object();
+      if (!seen)
+        return -1;
+      cast_json_space(cursor);
+      if (**cursor == '}')
+        { (*cursor)++; ret = 0; goto object_done; }
+      for (;;)
+        {
+          end = cast_json_string_end(*cursor);
+          if (!end || ++fields > 64)
+            goto object_done;
+          length = end - *cursor;
+          tokener = json_tokener_new();
+          if (!tokener)
+            goto object_done;
+          key = json_tokener_parse_ex(tokener, *cursor, (int)length);
+          if (json_tokener_get_error(tokener) != json_tokener_success || !key)
+            { json_tokener_free(tokener); if (key) json_object_put(key); goto object_done; }
+          json_tokener_free(tokener);
+          name = json_object_get_string(key);
+          if ((size_t)json_object_get_string_len(key) != strlen(name)
+              || json_object_object_get_ex(seen, name, &old))
+            { json_object_put(key); goto object_done; }
+          if (json_object_object_add(seen, name, NULL) < 0)
+            { json_object_put(key); goto object_done; }
+          json_object_put(key);
+          *cursor = end;
+          cast_json_space(cursor);
+          if (*(*cursor)++ != ':' || cast_json_unique(cursor, depth + 1) < 0)
+            goto object_done;
+          cast_json_space(cursor);
+          if (**cursor == '}')
+            { (*cursor)++; ret = 0; goto object_done; }
+          if (*(*cursor)++ != ',')
+            goto object_done;
+          cast_json_space(cursor);
+        }
+     object_done:
+      json_object_put(seen);
+      return ret;
+    }
+  if (**cursor == '[')
+    {
+      (*cursor)++;
+      cast_json_space(cursor);
+      if (**cursor == ']')
+        { (*cursor)++; return 0; }
+      for (;;)
+        {
+          if (cast_json_unique(cursor, depth + 1) < 0)
+            return -1;
+          cast_json_space(cursor);
+          closing = *(*cursor)++;
+          if (closing == ']')
+            return 0;
+          if (closing != ',')
+            return -1;
+        }
+    }
+  if (**cursor == '"')
+    {
+      end = cast_json_string_end(*cursor);
+      if (!end)
+        return -1;
+      *cursor = end;
+      return 0;
+    }
+  end = *cursor;
+  while (**cursor && **cursor != ',' && **cursor != ']' && **cursor != '}'
+         && **cursor != ' ' && **cursor != '\t' && **cursor != '\r' && **cursor != '\n')
+    (*cursor)++;
+  length = *cursor - end;
+  if ((length == 4 && (!memcmp(end, "true", 4) || !memcmp(end, "null", 4)))
+      || (length == 5 && !memcmp(end, "false", 5)))
+    return 0;
+  return cast_json_number(end, *cursor);
+}
+
+static json_object *
+cast_json_parse(const char *text, size_t maximum)
+{
+  json_object *body;
+  struct json_tokener *tokener;
+  const char *cursor = text;
+  size_t length;
+  if (!text || !(length = strnlen(text, maximum + 1)) || length > maximum)
+    return NULL;
+  tokener = json_tokener_new_ex(32);
+  if (!tokener)
+    return NULL;
+  json_tokener_set_flags(tokener, JSON_TOKENER_STRICT | JSON_TOKENER_VALIDATE_UTF8);
+  body = json_tokener_parse_ex(tokener, text, (int)length + 1);
+  if (json_tokener_get_error(tokener) != json_tokener_success
+      || !body || json_object_get_type(body) != json_type_object)
+    { if (body) json_object_put(body); json_tokener_free(tokener); return NULL; }
+  json_tokener_free(tokener);
+  if (cast_json_unique(&cursor, 0) < 0)
+    { json_object_put(body); return NULL; }
+  cast_json_space(&cursor);
+  if (*cursor)
+    { json_object_put(body); return NULL; }
+  return body;
+}
+#endif
