 /* --------------------------- CAST MESSAGE HANDLING ------------------------ */
 
+/* Exact request identities and independent monotonic deadlines. */
+static int64_t
+cast_reply_now(void)
+{
+  struct timespec now;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) < 0 || now.tv_sec < 0
+      || now.tv_nsec < 0 || now.tv_nsec >= 1000000000LL
+      || now.tv_sec > (INT64_MAX - now.tv_nsec) / 1000000000LL)
+    return -1;
+  return (int64_t)now.tv_sec * 1000000000LL + now.tv_nsec;
+}
+
+static int
+cast_reply_schedule(struct cast_session *cs)
+{
+  int64_t earliest = INT64_MAX, now, delta;
+  struct timeval wait;
+  unsigned int i;
+  for (i = 0; i < CALLBACK_REGISTER_SIZE; i++)
+    if (cs->callback_register[i].completion && cs->callback_register[i].deadline_ns < earliest)
+      earliest = cs->callback_register[i].deadline_ns;
+  if (earliest == INT64_MAX)
+    return evtimer_del(cs->reply_timeout);
+  now = cast_reply_now();
+  if (now < 0)
+    return -1;
+  delta = earliest > now ? earliest - now : 1;
+  wait.tv_sec = delta / 1000000000LL;
+  wait.tv_usec = (delta % 1000000000LL + 999) / 1000;
+  if (wait.tv_usec == 1000000)
+    { wait.tv_sec++; wait.tv_usec = 0; }
+  return event_add(cs->reply_timeout, &wait);
+}
+
+static int
+cast_reply_take(struct cast_session *cs, unsigned int request_id, struct cast_reply_entry *entry)
+{
+  struct cast_reply_entry *pending = &cs->callback_register[request_id % CALLBACK_REGISTER_SIZE];
+  if (!pending->completion || pending->request_id != request_id)
+    return 0;
+  *entry = *pending;
+  memset(pending, 0, sizeof(*pending));
+  /* Reschedule before completion: it may enqueue work or destroy cs. */
+  return cast_reply_schedule(cs) < 0 ? -1 : 1;
+}
