 {
   struct evkeyval *header;
   const char *expected = evrtsp_find_header(req->output_headers, "CSeq");
   const char *received = NULL;
   unsigned int count = 0;
   if (!expected || !*expected)
     return -1;
   TAILQ_FOREACH(header, req->input_headers, next)
     if (strcasecmp(header->key, "CSeq") == 0)
       { received = header->value; count++; }
   return count == 1 && received && strcmp(received, expected) == 0 ? 0 : -1;
 }
 
