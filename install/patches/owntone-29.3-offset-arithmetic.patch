+// Checked conversions preserve integer rounding and the backend's target width.
+int
+outputs_buffer_samples_get(uint64_t *samples, uint64_t duration_ms, int sample_rate, uint64_t limit)
+{
+  uint64_t value;
+  if (!samples || sample_rate <= 0 || duration_ms > UINT64_MAX / (unsigned)sample_rate)
+    return -1;
+  value = duration_ms * (unsigned)sample_rate / 1000;
+  if (value > limit)
+    return -1;
+  *samples = value;
+  return 0;
+}
+
+int
+outputs_buffer_size_get(uint64_t *bytes, uint64_t frames, int bits_per_sample, int channels, uint64_t limit)
+{
+  uint64_t bytes_per_frame;
+  if (!bytes || bits_per_sample <= 0 || bits_per_sample % 8 || channels <= 0)
+    return -1;
+  bytes_per_frame = (uint64_t)(unsigned)channels * (unsigned)(bits_per_sample / 8);
+  if (frames > UINT64_MAX / bytes_per_frame || frames * bytes_per_frame > limit)
+    return -1;
+  *bytes = frames * bytes_per_frame;
+  return 0;
+}
+
