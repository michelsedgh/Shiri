   ret = outputs_quality_subscribe(&fifo_quality);
   if (ret < 0)
     return -1;
 
   fifo_session = fifo_session_make(device, callback_id);
   if (!fifo_session)
     return -1;
 
   ret = fifo_open(fifo_session);
   if (ret < 0)
     return -1;
 
   fifo_status(fifo_session);
 
   return 1;
