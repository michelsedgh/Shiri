[Unit]
Description=Shiri privileged room audio runtime
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/shiri/shiri.env
ExecStart=@PREFIX@/venv/bin/python -m shiri.runtime.broker
RuntimeDirectory=shiri
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007
KillMode=control-group
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
# The setup broker must create /run/netns mounts in the host mount namespace.
# Filesystem sandbox directives detach propagation even with MountFlags=shared,
# making namespaces invisible to replacement brokers after a service crash.
# Apply those directives to the API and future unprivileged daemon units instead.
PrivateMounts=no
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE CAP_KILL CAP_DAC_OVERRIDE CAP_CHOWN CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
LockPersonality=true

[Install]
WantedBy=multi-user.target
